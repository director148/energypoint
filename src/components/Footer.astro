---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<a href="/" aria-label="Energy Point home">
					<img
						src="/images/energy-point-logo-white-240.webp"
						srcset="/images/energy-point-logo-white-240.webp 240w, /images/energy-point-logo-white.webp 420w"
						sizes="141px"
						alt="Energy Point"
						width="240"
						height="146"
						loading="lazy"
					/>
				</a>
				<p>
					Personalised solar and smart energy plans for homes, businesses and rural
					properties across the Waikato.
				</p>
			</div>

			<div class="footer-column">
				<h2>Solutions</h2>
				<nav aria-label="Footer solutions">
					<a href="/residential/">Residential</a>
					<a href="/commercial/">Commercial</a>
					<a href="/rural/">Rural</a>
					<a href="/maintenance/">Maintenance</a>
					<a href="/finance/">Finance</a>
				</nav>
			</div>

			<div class="footer-column">
				<h2>Energy Point</h2>
				<nav aria-label="Footer company">
					<a href="/about-us/">About us</a>
					<a href="/reviews/">Reviews</a>
					<a href="/frequently-asked-questions/">FAQs</a>
					<a href="/contact/">Contact</a>
				</nav>
				<nav class="footer-social" aria-label="Social media">
					<a href={site.facebook} target="_blank" rel="noreferrer" aria-label="Facebook">
						<Icon name="facebook" size={18} />
					</a>
					<a href={site.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
						<Icon name="instagram" size={18} />
					</a>
				</nav>
			</div>

			<div class="footer-column">
				<h2>Talk to us</h2>
				<nav aria-label="Footer contact">
					<a href={site.phoneHref}>{site.phoneDisplay}</a>
					<a href={`mailto:${site.email}`}>{site.email}</a>
					<span>{site.hours}</span>
					<span>{site.region}</span>
				</nav>
			</div>
		</div>

		<div class="site-footer__bottom">
			<span>© {year} Energy Point. All rights reserved.</span>
			<span>Locally owned. Waikato proud. People first.</span>
		</div>
	</div>
</footer>

