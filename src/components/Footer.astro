---
import Icon from './Icon.astro';
import { legalPages } from '../data/legal';
import { footerLogos, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<a href="/" aria-label="Energy Point home">
					<img
						src="/images/energy-point-logo-white-240.webp"
						srcset="/images/energy-point-logo-white-240.webp 240w, /images/energy-point-logo-white.webp 420w"
						sizes="141px"
						alt="Energy Point"
						width="240"
						height="146"
						loading="lazy"
					/>
				</a>
				<p>
					Personalised solar and energy plans for homes, businesses and rural
					properties across the Waikato.
				</p>
				<nav class="site-footer__social" aria-label="Social">
					<a href={site.facebook} target="_blank" rel="noreferrer">
						<Icon name="facebook" size={18} />
						Facebook
					</a>
					<a href={site.instagram} target="_blank" rel="noreferrer">
						<Icon name="instagram" size={18} />
						Instagram
					</a>
				</nav>
			</div>

			<div class="footer-column">
				<h2>Solutions</h2>
				<nav aria-label="Footer solutions">
					<a href="/residential/">Residential</a>
					<a href="/commercial/">Commercial</a>
					<a href="/rural/">Rural</a>
					<a href="/maintenance/">Maintenance</a>
				</nav>
			</div>

			<div class="footer-column">
				<h2>Energy Point</h2>
				<nav aria-label="Footer company">
					<a href="/how-it-works/">How it works</a>
					<a href="/finance/">Finance</a>
					<a href="/frequently-asked-questions/">FAQs</a>
				</nav>
			</div>

			<div class="footer-column">
				<h2>Company</h2>
				<nav aria-label="Footer company pages">
					<a href="/meet-the-team/">Meet the team</a>
					<a href="/reviews/">Reviews</a>
					<a href="/contact/">Contact</a>
				</nav>
			</div>

			<div class="footer-column">
				<h2>Talk with us</h2>
				<nav aria-label="Footer contact">
					<a href={site.phoneHref}>{site.phoneDisplay}</a>
					<span>9am - 5pm</span>
					<span>Monday - Friday</span>
					<span>{site.region}</span>
				</nav>
			</div>
		</div>

		<nav class="site-footer__logos" aria-label="Partners">
			{
				footerLogos.map((logo) => (
					<a
						href={logo.href}
						target={logo.external ? '_blank' : undefined}
						rel={logo.external ? 'noreferrer' : undefined}
					>
						<img
							class:list={[logo.compact && 'is-compact']}
							src={logo.src}
							alt={logo.alt}
							width={logo.width}
							height={logo.height}
							loading="lazy"
						/>
					</a>
				))
			}
		</nav>

		<div class="site-footer__bottom">
			<span>© {year} Energy Point. All rights reserved.</span>
			<nav class="footer-legal" aria-label="Legal">
				{
					legalPages.map((page) => (
						<a href={page.href}>{page.label}</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>

