---
import { navigation, site } from '../data/site';

interface Props {
	/** Force the light-background treatment. Pages without a hero must set this. */
	onLight?: boolean;
}

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);

/* Pages with no hero image sit on cream, so white header text is unreadable. */
const lightPaths = [
	'/contact',
	'/thank-you',
	'/privacy',
	'/terms',
	'/cookies',
	'/disclaimer',
	'/accessibility',
];
const onLight =
	Astro.props.onLight ?? lightPaths.some((path) => pathname.startsWith(path));
---

<header class:list={['site-header', onLight && 'site-header--on-light']} data-site-header>
	<div class="site-header__bar">
		<a class="brand" href="/" aria-label="Energy Point home">
			<img
				src="/images/energy-point-logo-white-240.webp"
				srcset="/images/energy-point-logo-white-240.webp 240w, /images/energy-point-logo-white.webp 420w"
				sizes="113px"
				alt="Energy Point"
				width="240"
				height="146"
			/>
		</a>

		<nav class="desktop-nav" aria-label="Main navigation">
			{
				navigation.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header-actions">
			<a class="button button--light" href="/contact/">Book a visit</a>
			<a class="header-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
			<button
				class="menu-toggle"
				type="button"
				aria-label="Open navigation menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
			>
				<span></span>
			</button>
		</div>
	</div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu data-open="false">
	<nav aria-label="Mobile navigation">
		{
			navigation.map((item) => (
				<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
	<div class="mobile-menu__meta">
		<a class="button button--light mobile-menu__action" href={site.phoneHref}>
			{site.phoneDisplay}
		</a>
		<a class="button button--light mobile-menu__action" href="/contact/">
			Book a free visit
		</a>
	</div>
</div>

<script>
	let headerController: AbortController | undefined;

	const initHeader = () => {
		headerController?.abort();
		headerController = new AbortController();
		const { signal } = headerController;

		const header = document.querySelector('[data-site-header]');
		const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
		let lastY = window.scrollY;

		const closeMenu = () => {
			if (!toggle || !menu) return;
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Open navigation menu');
			menu.dataset.open = 'false';
			document.body.classList.remove('nav-open');
		};

		closeMenu();

		toggle?.addEventListener(
			'click',
			() => {
				const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
				toggle.setAttribute('aria-expanded', String(willOpen));
				toggle.setAttribute(
					'aria-label',
					willOpen ? 'Close navigation menu' : 'Open navigation menu',
				);
				if (menu) menu.dataset.open = String(willOpen);
				document.body.classList.toggle('nav-open', willOpen);
				if (willOpen) header?.classList.remove('is-hidden');
			},
			{ signal },
		);

		menu
			?.querySelectorAll('a')
			.forEach((link) => link.addEventListener('click', closeMenu, { signal }));

		document.addEventListener(
			'keydown',
			(event) => {
				if (event.key === 'Escape') closeMenu();
			},
			{ signal },
		);

		window.addEventListener(
			'scroll',
			() => {
				if (!(header instanceof HTMLElement)) return;

				const y = Math.max(0, window.scrollY);
				header.classList.toggle('is-scrolled', y > 40);

				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (reduceMotion || document.body.classList.contains('nav-open') || y < 72) {
					header.classList.remove('is-hidden');
					lastY = y;
					return;
				}

				const delta = y - lastY;
				if (Math.abs(delta) < 6) return;

				header.classList.toggle('is-hidden', delta > 0);
				lastY = y;
			},
			{ passive: true, signal },
		);
		header?.classList.toggle('is-scrolled', window.scrollY > 40);
		header?.classList.remove('is-hidden');
	};

	document.addEventListener('astro:page-load', initHeader);
</script>

