---
interface Props {
	defaultAudience?: string;
	subject?: string;
}

const {
	defaultAudience = '',
	subject = 'New Energy Point consultation enquiry',
} = Astro.props;

const audiences = ['Residential', 'Commercial', 'Rural'];
const goals = [
	'Reduce electricity costs',
	'Add energy resilience',
	'Plan a new build',
	'Battery or EV readiness',
	'Maintenance or servicing',
	'Not sure yet',
] as const;
const preferredTimes = ['Morning', 'Afternoon', 'Either'] as const;
const authorities = [
	'I own the property',
	'I act for the owner',
	'This is a business',
	'I am exploring',
] as const;

const isMaintenanceIntent = defaultAudience.toLowerCase() === 'maintenance';
const propertyDefault = isMaintenanceIntent ? '' : defaultAudience;
---

<form
	class="contact-form"
	name="energy-plan"
	method="POST"
	action="/api/contact"
	enctype="multipart/form-data"
	novalidate
	data-contact-form
>
	<input type="hidden" name="subject" value={subject} />

	<p class="field field--honeypot" hidden>
		<label>
			Do not complete this field
			<input name="bot-field" tabindex="-1" autocomplete="off" />
		</label>
	</p>

	<p class="contact-form__error" data-form-error hidden></p>

	<div class="field">
		<label for="firstName">First name</label>
		<input
			id="firstName"
			name="firstName"
			type="text"
			autocomplete="given-name"
			required
			minlength="2"
			maxlength="20"
			spellcheck="false"
			autocapitalize="words"
			pattern="\p{L}[\p{L}\-]{1,19}"
			title="Use letters or hyphens only"
			data-name-field
		/>
		<span class="field__error" data-error-for="firstName" hidden></span>
	</div>

	<div class="field">
		<label for="lastName">Last name</label>
		<input
			id="lastName"
			name="lastName"
			type="text"
			autocomplete="family-name"
			required
			minlength="2"
			maxlength="20"
			spellcheck="false"
			autocapitalize="words"
			pattern="\p{L}[\p{L}\-]{1,19}"
			title="Use letters or hyphens only"
			data-name-field
		/>
		<span class="field__error" data-error-for="lastName" hidden></span>
	</div>

	<div class="field">
		<label for="phone">Phone</label>
		<input
			id="phone"
			name="phone"
			type="tel"
			autocomplete="tel"
			inputmode="tel"
			required
			maxlength="32"
			data-phone-field
		/>
		<span class="field__error" data-error-for="phone" hidden></span>
	</div>

	<div class="field">
		<label for="email">Email</label>
		<input
			id="email"
			name="email"
			type="email"
			autocomplete="email"
			required
			maxlength="150"
			inputmode="email"
			data-email-field
		/>
		<span class="field__error" data-error-for="email" hidden></span>
	</div>

	<div class="field field--full">
		<label for="address">Property address</label>
		<div class="address-field">
			<input
				id="address"
				name="address"
				type="text"
				autocomplete="street-address"
				required
				minlength="5"
				maxlength="120"
				role="combobox"
				aria-autocomplete="list"
				aria-controls="address-suggestions"
				aria-expanded="false"
				data-address-search
			/>
			<span class="address-loader" data-address-loader hidden></span>
		</div>
		<span class="sr-only" data-address-status aria-live="polite"></span>
		<div class="address-suggest-shell" data-address-shell>
			<ul id="address-suggestions" class="address-suggest" role="listbox"></ul>
		</div>
		<span class="field__error" data-error-for="address" hidden></span>
	</div>

	<div class="field">
		<label for="audience">Property type</label>
		<select id="audience" name="audience" required data-audience-select>
			<option value="" selected={!propertyDefault}>Choose one</option>
			{
				audiences.map((audience) => (
					<option value={audience} selected={propertyDefault.toLowerCase() === audience.toLowerCase()}>
						{audience}
					</option>
				))
			}
		</select>
		<span class="field__error" data-error-for="audience" hidden></span>
	</div>

	<div class="field">
		<label for="goal">{isMaintenanceIntent ? 'What do you need?' : 'Main goal'}</label>
		<select id="goal" name="goal" required data-goal-select>
			<option value="" selected={!isMaintenanceIntent}>Choose one</option>
			{
				goals.map((goal) => (
					<option
						value={goal}
						selected={isMaintenanceIntent && goal === 'Maintenance or servicing'}
					>
						{goal}
					</option>
				))
			}
		</select>
		<span class="field__error" data-error-for="goal" hidden></span>
	</div>

	<div class="field">
		<label for="authority">Your role</label>
		<select id="authority" name="authority" required>
			<option value="">Choose one</option>
			{authorities.map((option) => <option value={option}>{option}</option>)}
		</select>
		<span class="field__error" data-error-for="authority" hidden></span>
	</div>

	<div class="field">
		<div class="field-head">
			<label for="uploads">Uploads (optional)</label>
			<span class="field-info">
				<button type="button" class="field-info__mark" aria-label="What to upload" aria-describedby="uploads-hint">
					i
				</button>
				<span id="uploads-hint" class="field-info__tip" role="tooltip">
					Latest electric bill, 12-month report or property photos. We can start without them.
				</span>
			</span>
		</div>
		<div class="file-field" data-file-field>
			<label class="file-field__pick" for="uploads">
				<input
					id="uploads"
					class="sr-only"
					name="uploads"
					type="file"
					accept="image/jpeg,image/png,image/webp,application/pdf,.pdf,.csv,text/csv,.xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"
					multiple
					data-upload-input
					aria-describedby="uploads-hint"
				/>
				<span data-file-pick>Upload files</span>
			</label>
			<span class="file-field__summary" data-file-summary hidden></span>
			<button type="button" class="file-field__clear" data-file-clear hidden>Remove</button>
		</div>
		<span class="field__error" data-error-for="uploads" hidden></span>
	</div>

	<div class="field">
		<label for="monthlyBill">Electric bill</label>
		<div class="field__amount">
			<span class="field__currency" aria-hidden="true">$</span>
			<input
				id="monthlyBill"
				name="monthlyBill"
				type="text"
				maxlength="6"
				inputmode="numeric"
				autocomplete="off"
				title="Numbers only"
				data-bill-field
				aria-describedby="monthlyBill-period"
			/>
			<span class="field__period" id="monthlyBill-period">/ month</span>
		</div>
		<span class="field__error" data-error-for="monthlyBill" hidden></span>
	</div>

	<div class="field">
		<label for="preferredTime">Best time to call</label>
		<select id="preferredTime" name="preferredTime" required>
			<option value="">Choose one</option>
			{preferredTimes.map((option) => <option value={option}>{option}</option>)}
		</select>
		<span class="field__error" data-error-for="preferredTime" hidden></span>
	</div>

	<div class="field field--full">
		<label for="message">What should we know? (optional)</label>
		<textarea
			id="message"
			name="message"
			placeholder={
				isMaintenanceIntent
					? 'Inverter alerts, damaged panels, when generation dropped or how we get on site.'
					: 'Roof type and shading, an existing system, a battery or EV on the way, switchboard notes or when you want us there.'
			}
			maxlength="1000"
			rows="3"
			autocapitalize="sentences"
			data-message-field
		></textarea>
		<span class="field__error" data-error-for="message" hidden></span>
	</div>

	<div class="contact-form__footer">
		<p>
			By sending this form, you agree that Energy Point may contact you about this enquiry. Read
			the <a href="/privacy/">privacy policy</a>.
		</p>
		<button class="button" type="submit">Submit</button>
	</div>
</form>

<script>
	import { photonSearchUrl, suggestionsFromPhoton } from '../lib/nz-address-search.js';

	const LIMITS = {
		firstName: 20,
		lastName: 20,
		phone: 32,
		email: 150,
		address: 120,
		message: 1000,
		monthlyBill: 5,
		photos: 6,
		photoBytes: 12 * 1024 * 1024,
		photoStoredBytes: 2 * 1024 * 1024,
		photoEdge: 1600,
		photoQuality: 0.8,
		billBytes: 8 * 1024 * 1024,
		usageBytes: 5 * 1024 * 1024,
	};

	const SAFE_TEXT = /^[\p{L}\p{N}\s.,'’/#&\-()+@:+]+$/u;
	const NAME_PART = /^\p{L}[\p{L}\-]{0,19}$/u;
	const EMAIL =
		/^[a-z0-9](?:[a-z0-9._%+-]{0,62}[a-z0-9])?@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/;
	const ADDRESS = /^[\p{L}\p{N}\s.,'’/#&\-]{5,120}$/u;

	const sanitisePhone = (value) =>
		String(value || '')
			.replace(/[^\d+()-]/g, '')
			.replace(/(?!^)\+/g, '')
			.slice(0, 32);

	const cleanPhone = (value) => {
		let digits = sanitisePhone(value).replace(/[^\d+]/g, '');
		if (digits.startsWith('0064')) digits = `+64${digits.slice(4)}`;
		if (digits.startsWith('64') && digits.length >= 10) digits = `+${digits}`;
		if (digits.startsWith('+64')) digits = `0${digits.slice(3)}`;
		return digits.replace(/\D/g, '');
	};

	const isValidPhone = (value) => {
		const raw = sanitisePhone(value).replace(/[^\d+]/g, '');
		const digits = raw.replace(/\D/g, '');
		if (digits.length > (raw.startsWith('00') ? 17 : 15)) return false;
		if (/^\+[1-9]\d{7,14}$/.test(raw) || /^00[1-9]\d{7,14}$/.test(raw)) return true;

		const local = cleanPhone(value);
		return (
			/^02\d{7,9}$/.test(local) ||
			/^0[34679]\d{7}$/.test(local) ||
			/^0800\d{6,7}$/.test(local) ||
			/^0508\d{6}$/.test(local)
		);
	};

	const sanitiseEmail = (value) =>
		String(value || '')
			.normalize('NFKC')
			.replace(/\s+/g, '')
			.replace(/[^A-Za-z0-9.@_%+-]/g, '')
			.toLowerCase()
			.slice(0, 150);

	const isValidEmail = (value) => {
		const email = sanitiseEmail(value);
		if (!email || email.length > 150) return false;
		if (email.includes('..')) return false;
		if ((email.match(/@/g) || []).length !== 1) return false;
		return EMAIL.test(email) && /\.[a-z]{2,}$/.test(email);
	};

	const titleCaseNameParts = (value) =>
		String(value || '').replace(/\p{L}+/gu, (part) => part[0].toUpperCase() + part.slice(1).toLowerCase());

	const sanitiseName = (value) => {
		const cleaned = String(value || '')
			.normalize('NFKC')
			.replace(/[^\p{L}-]/gu, '')
			.replace(/-{2,}/g, '-')
			.replace(/^-+|-+$/g, '')
			.slice(0, 20);

		return cleaned ? titleCaseNameParts(cleaned) : '';
	};

	const capitaliseFirstLetter = (value) =>
		String(value || '').replace(/^(\s*)(\p{L})/u, (_, space, letter) => space + letter.toUpperCase());

	const blobToFile = (blob, name) => new File([blob], name, { type: blob.type, lastModified: Date.now() });

	const canvasToBlob = (canvas, type, quality) =>
		new Promise((resolve) => {
			canvas.toBlob((blob) => resolve(blob), type, quality);
		});

	const encodePhoto = async (bitmap, edge, quality) => {
		const scale = Math.min(1, edge / Math.max(bitmap.width, bitmap.height));
		const width = Math.max(1, Math.round(bitmap.width * scale));
		const height = Math.max(1, Math.round(bitmap.height * scale));
		const canvas = document.createElement('canvas');
		canvas.width = width;
		canvas.height = height;
		const ctx = canvas.getContext('2d');
		if (!ctx) throw new Error('Could not prepare this photo.');
		ctx.drawImage(bitmap, 0, 0, width, height);

		const webp = await canvasToBlob(canvas, 'image/webp', quality);
		if (webp && webp.size > 0) return blobToFile(webp, 'photo.webp');

		const jpeg = await canvasToBlob(canvas, 'image/jpeg', Math.min(0.82, quality + 0.02));
		if (jpeg && jpeg.size > 0) return blobToFile(jpeg, 'photo.jpg');

		throw new Error('Could not convert this photo.');
	};

	const compressImage = async (file) => {
		const bitmap = await createImageBitmap(file);
		try {
			let edge = LIMITS.photoEdge;
			let quality = LIMITS.photoQuality;

			for (let attempt = 0; attempt < 8; attempt++) {
				const encoded = await encodePhoto(bitmap, edge, quality);
				if (encoded.size <= LIMITS.photoStoredBytes) return encoded;
				if (quality > 0.5) quality = Math.round((quality - 0.1) * 10) / 10;
				else {
					edge = Math.max(640, Math.round(edge * 0.8));
					quality = 0.72;
				}
			}

			throw new Error('too-large');
		} finally {
			bitmap.close();
		}
	};

	const isCsvFile = (file) => {
		const name = String(file?.name || '').toLowerCase();
		const type = String(file?.type || '').toLowerCase();
		return name.endsWith('.csv') || type === 'text/csv' || type === 'text/plain';
	};

	const isSpreadsheetFile = (file) => {
		const name = String(file?.name || '').toLowerCase();
		const type = String(file?.type || '').toLowerCase();
		return (
			name.endsWith('.xlsx') ||
			name.endsWith('.xls') ||
			type === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
			type === 'application/vnd.ms-excel'
		);
	};

	const isUsageFile = (file) => isCsvFile(file) || isSpreadsheetFile(file);

	const isPdfFile = (file) => {
		const name = String(file?.name || '').toLowerCase();
		const type = String(file?.type || '').toLowerCase();
		return type === 'application/pdf' || name.endsWith('.pdf');
	};

	const isBillFile = (file) => isPdfFile(file);

	const classifyUploads = (billFile, usageFile, photos) => ({
		bill: billFile,
		usage: usageFile,
		photos,
	});

	const validate = (form, extras = {}) => {
		const photoCount = extras.photoCount || 0;
		const bill = extras.bill;
		const usage = extras.usage;
		const data = new FormData(form);
		const errors = {};
		const monthlyBill = String(data.get('monthlyBill') || '').replace(/\D/g, '').slice(0, LIMITS.monthlyBill);
		const values = {
			audience: String(data.get('audience') || '').trim(),
			goal: String(data.get('goal') || '').trim(),
			preferredTime: String(data.get('preferredTime') || '').trim(),
			authority: String(data.get('authority') || '').trim(),
			monthlyBill,
			firstName: sanitiseName(data.get('firstName')),
			lastName: sanitiseName(data.get('lastName')),
			phone: sanitisePhone(data.get('phone')),
			email: sanitiseEmail(data.get('email')),
			address: String(data.get('address') || '').trim().replace(/\s+/g, ' '),
			message: capitaliseFirstLetter(String(data.get('message') || '').trim().replace(/\s+/g, ' ')),
		};

		if (!values.audience) errors.audience = 'Choose a property type.';
		if (!values.goal) errors.goal = 'Choose a main goal.';
		if (!values.preferredTime) errors.preferredTime = 'Choose a time that suits.';
		if (!values.authority) errors.authority = 'Tell us your role.';
		if (values.monthlyBill && Number(values.monthlyBill) > 10 ** LIMITS.monthlyBill - 1) {
			errors.monthlyBill = 'Enter a typical monthly amount or leave this blank.';
		}

		if (!values.firstName || values.firstName.length < 2) errors.firstName = 'Enter your first name.';
		else if (values.firstName.length > LIMITS.firstName) {
			errors.firstName = `First name must be ${LIMITS.firstName} characters or fewer.`;
		} else if (!NAME_PART.test(values.firstName)) {
			errors.firstName = 'Use letters only.';
		}

		if (!values.lastName || values.lastName.length < 2) errors.lastName = 'Enter your last name.';
		else if (values.lastName.length > LIMITS.lastName) {
			errors.lastName = `Last name must be ${LIMITS.lastName} characters or fewer.`;
		} else if (!NAME_PART.test(values.lastName)) {
			errors.lastName = 'Use letters only.';
		}

		if (!values.phone) errors.phone = 'Enter a phone number.';
		else if (values.phone.length > LIMITS.phone) errors.phone = `Phone must be ${LIMITS.phone} characters or fewer.`;
		else if (!isValidPhone(values.phone)) {
			errors.phone = 'Enter a local or international number, such as 021 123 4567 or +61 412 345 678.';
		}

		if (!values.email) errors.email = 'Enter an email address.';
		else if (values.email.length > LIMITS.email) errors.email = `Email must be ${LIMITS.email} characters or fewer.`;
		else if (!isValidEmail(values.email)) errors.email = 'Enter a valid email address.';

		if (!values.address) errors.address = 'Enter the property address.';
		else if (values.address.length > LIMITS.address) {
			errors.address = `Address must be ${LIMITS.address} characters or fewer.`;
		} else if (!ADDRESS.test(values.address)) {
			errors.address = 'Use a normal street address without special symbols.';
		}

		if (values.message) {
			if (values.message.length < 10) {
				errors.message = 'Tell us a little more (at least 10 characters) or leave this blank.';
			} else if (values.message.length > LIMITS.message) {
				errors.message = `Message must be ${LIMITS.message} characters or fewer.`;
			} else if (!SAFE_TEXT.test(values.message)) {
				errors.message = 'Remove unusual symbols from your message.';
			}
		}

		if (bill && !isBillFile(bill)) errors.uploads = 'Use a PDF for the bill.';
		else if (bill && bill.size > LIMITS.billBytes) errors.uploads = 'The bill must be under 8MB.';
		else if (usage && !isUsageFile(usage)) errors.uploads = 'Use a CSV or Excel file from your retailer.';
		else if (usage && usage.size > LIMITS.usageBytes) errors.uploads = 'The usage file must be under 5MB.';
		else if (photoCount > LIMITS.photos) {
			errors.uploads = `Add ${LIMITS.photos} photos or fewer.`;
		} else if ((extras.photos || []).some((photo) => photo.size > LIMITS.photoStoredBytes)) {
			errors.uploads = 'A photo is still over 2MB after compressing. Try another image.';
		}

		return { values, errors, ok: Object.keys(errors).length === 0 };
	};

	const SEND_FAILED = 'Could not send enquiry. Please try again.';
	const SAFE_ERROR_MAX = 180;
	const SAFE_ERROR_CHARS = /^[\p{L}\p{N}\s.,'!?:+#()/\\-]+$/u;
	const INTERNAL_ERROR = /not configured|resend|api key|delivery is/i;

	const customerErrorMessage = (text, fallback = SEND_FAILED) => {
		const oneLine = String(text || '')
			.replace(/\s+/g, ' ')
			.trim();
		if (
			!oneLine ||
			oneLine.length > SAFE_ERROR_MAX ||
			/[<>]/.test(oneLine) ||
			!SAFE_ERROR_CHARS.test(oneLine) ||
			INTERNAL_ERROR.test(oneLine)
		) {
			return fallback;
		}
		return oneLine;
	};

	const isHtmlResponse = (response) =>
		String(response.headers.get('content-type') || '')
			.toLowerCase()
			.includes('text/html');

	const messageFromResponse = async (response) => {
		if (response.status >= 500) return SEND_FAILED;
		if (isHtmlResponse(response)) return SEND_FAILED;

		const type = String(response.headers.get('content-type') || '').toLowerCase();
		try {
			if (type.includes('application/json')) {
				const data = await response.json();
				const msg =
					(typeof data.error === 'string' && data.error) ||
					(typeof data.message === 'string' && data.message) ||
					'';
				return customerErrorMessage(msg);
			}

			if (!type.includes('text/plain')) return SEND_FAILED;
			return customerErrorMessage(await response.text());
		} catch {
			return SEND_FAILED;
		}
	};

	const showFormError = (form, message) => {
		const formError = form.querySelector('[data-form-error]');
		if (!(formError instanceof HTMLElement)) return;
		formError.replaceChildren();
		if (message) {
			formError.textContent = customerErrorMessage(message);
			formError.hidden = false;
		} else {
			formError.hidden = true;
		}
	};

	const showErrors = (form, errors) => {
		form.querySelectorAll('[data-error-for]').forEach((el) => {
			const key = el.getAttribute('data-error-for');
			const message = key ? errors[key] : '';
			const field = el.closest('.field');
			const control = field?.querySelector('input, select, textarea');

			if (message) {
				el.textContent = customerErrorMessage(message);
				el.hidden = false;
				field?.classList.add('field--invalid');
				control?.setAttribute('aria-invalid', 'true');
			} else {
				el.textContent = '';
				el.hidden = true;
				field?.classList.remove('field--invalid');
				control?.removeAttribute('aria-invalid');
			}
		});

		showFormError(form, Object.values(errors)[0] || '');
	};

	const applyAudienceFromQuery = (form) => {
		const params = new URLSearchParams(window.location.search);
		const audience = params.get('audience');
		if (!audience) return;

		const setSelect = (name, value) => {
			const field = form.elements.namedItem(name);
			if (!(field instanceof HTMLSelectElement)) return;
			const match = Array.from(field.options).find(
				(item) => item.value.toLowerCase() === value.toLowerCase(),
			);
			if (match) field.value = match.value;
		};

		if (audience.toLowerCase() === 'maintenance') {
			setSelect('goal', 'Maintenance or servicing');
			return;
		}

		setSelect('audience', audience);
	};

	const fetchAddressSuggestions = async (value, signal) => {
		try {
			const response = await fetch(`/api/address-search?q=${encodeURIComponent(value)}`, {
				signal,
			});
			if (response.ok) {
				const data = await response.json();
				if (Array.isArray(data.suggestions)) return data.suggestions;
			}
		} catch (error) {
			if (error?.name === 'AbortError') throw error;
		}

		const response = await fetch(photonSearchUrl(value), { signal });
		if (!response.ok) return [];
		return suggestionsFromPhoton(await response.json());
	};

	const initAddressSearch = (input) => {
		if (!(input instanceof HTMLInputElement)) return;

		const list = document.getElementById('address-suggestions');
		const shell = document.querySelector('[data-address-shell]');
		const loader = document.querySelector('[data-address-loader]');
		const status = document.querySelector('[data-address-status]');
		if (!(list instanceof HTMLElement) || !(shell instanceof HTMLElement)) return;

		const setLoading = (on) => {
			input.setAttribute('aria-busy', on ? 'true' : 'false');
			if (loader instanceof HTMLElement) loader.hidden = !on;
			if (status) status.textContent = on ? 'Searching addresses' : '';
		};

		const cache = new Map();
		let controller = null;
		let timer = 0;
		let closeTimer = 0;
		let active = -1;
		let suggestions = [];

		const isOpen = () => shell.classList.contains('is-open');

		const close = () => {
			shell.classList.remove('is-open');
			input.setAttribute('aria-expanded', 'false');
			input.removeAttribute('aria-activedescendant');
			active = -1;
			suggestions = [];
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(() => {
				if (!isOpen()) list.replaceChildren();
			}, 240);
		};

		const choose = (value) => {
			input.value = value.slice(0, 120);
			setLoading(false);
			close();
		};

		const render = (items) => {
			suggestions = items;
			active = items.length ? 0 : -1;
			window.clearTimeout(closeTimer);
			list.replaceChildren();

			if (!items.length) {
				close();
				return;
			}

			items.forEach((label, index) => {
				const option = document.createElement('li');
				option.id = `address-option-${index}`;
				option.role = 'option';
				option.textContent = label;
				if (index === active) option.setAttribute('aria-selected', 'true');
				option.addEventListener('mousedown', (event) => {
					event.preventDefault();
					choose(label);
				});
				list.append(option);
			});

			input.setAttribute('aria-expanded', 'true');
			input.setAttribute('aria-activedescendant', 'address-option-0');
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					shell.classList.add('is-open');
				});
			});
		};

		const highlight = (index) => {
			active = index;
			Array.from(list.children).forEach((option, optionIndex) => {
				option.setAttribute('aria-selected', optionIndex === index ? 'true' : 'false');
			});
			if (index >= 0) input.setAttribute('aria-activedescendant', `address-option-${index}`);
		};

		const search = async (value) => {
			if (cache.has(value)) {
				setLoading(false);
				render(cache.get(value));
				return;
			}

			controller?.abort();
			controller = new AbortController();
			const current = controller;
			setLoading(true);

			try {
				const items = await fetchAddressSuggestions(value, current.signal);
				cache.set(value, items);
				if (input.value.trim().replace(/\s+/g, ' ') === value) render(items);
			} catch (error) {
				if (error?.name !== 'AbortError') close();
			} finally {
				if (controller === current) setLoading(false);
			}
		};

		input.addEventListener('input', () => {
			const value = input.value.trim().replace(/\s+/g, ' ');
			window.clearTimeout(timer);
			if (value.length < 3) {
				setLoading(false);
				close();
				return;
			}
			if (cache.has(value)) {
				setLoading(false);
				render(cache.get(value));
				return;
			}
			setLoading(true);
			close();
			timer = window.setTimeout(() => search(value), 280);
		});

		input.addEventListener('keydown', (event) => {
			if (!isOpen() || !suggestions.length) return;

			if (event.key === 'ArrowDown') {
				event.preventDefault();
				highlight((active + 1) % suggestions.length);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				highlight((active - 1 + suggestions.length) % suggestions.length);
			} else if (event.key === 'Enter' && active >= 0) {
				event.preventDefault();
				choose(suggestions[active]);
			} else if (event.key === 'Escape') {
				close();
			}
		});

		input.addEventListener('blur', () => {
			window.setTimeout(close, 120);
		});
	};

	document.addEventListener('astro:page-load', () => {
		const form = document.querySelector('[data-contact-form]');
		if (!(form instanceof HTMLFormElement)) return;

		applyAudienceFromQuery(form);
		initAddressSearch(form.querySelector('[data-address-search]'));

		form.querySelectorAll('[data-name-field]').forEach((input) => {
			if (!(input instanceof HTMLInputElement)) return;

			const applyNameFormat = () => {
				const cursor = input.selectionStart;
				const next = titleCaseNameParts(input.value.replace(/[^\p{L}-]/gu, ''));
				if (next === input.value) return;
				input.value = next;
				if (typeof cursor === 'number') {
					input.setSelectionRange(Math.min(cursor, next.length), Math.min(cursor, next.length));
				}
			};

			input.addEventListener('beforeinput', (event) => {
				if (event.inputType === 'insertText' && typeof event.data === 'string' && /[^\p{L}-]/u.test(event.data)) {
					event.preventDefault();
				}
			});

			input.addEventListener('input', applyNameFormat);
			input.addEventListener('change', applyNameFormat);
			input.addEventListener('blur', () => {
				input.value = sanitiseName(input.value);
			});
		});

		const phoneInput = form.querySelector('[data-phone-field]');
		if (phoneInput instanceof HTMLInputElement) {
			phoneInput.addEventListener('input', () => {
				const cursor = phoneInput.selectionStart;
				let next = phoneInput.value.replace(/[^\d+()-]/g, '').replace(/(?!^)\+/g, '');
				const maxDigits = next.trim().startsWith('00') ? 17 : 15;
				if ((next.replace(/\D/g, '') || '').length > maxDigits) {
					let kept = 0;
					next = next.replace(/\d/g, (digit) => {
						kept += 1;
						return kept > maxDigits ? '' : digit;
					});
				}
				if (next !== phoneInput.value) {
					phoneInput.value = next;
					if (typeof cursor === 'number') {
						phoneInput.setSelectionRange(Math.min(cursor, next.length), Math.min(cursor, next.length));
					}
				}
			});

			phoneInput.addEventListener('blur', () => {
				phoneInput.value = sanitisePhone(phoneInput.value);
				if (phoneInput.value && !isValidPhone(phoneInput.value)) {
					showErrors(form, { phone: 'Enter a local or international number, such as 021 123 4567 or +61 412 345 678.' });
					return;
				}
				if (phoneInput.value) showErrors(form, {});
			});
		}

		const messageInput = form.querySelector('[data-message-field]');
		if (messageInput instanceof HTMLTextAreaElement) {
			const applySentenceStart = () => {
				const cursor = messageInput.selectionStart;
				const next = capitaliseFirstLetter(messageInput.value);
				if (next === messageInput.value) return;
				messageInput.value = next;
				if (typeof cursor === 'number') {
					messageInput.setSelectionRange(cursor, cursor);
				}
			};

			messageInput.addEventListener('input', applySentenceStart);
			messageInput.addEventListener('blur', applySentenceStart);
		}

		const billInput = form.querySelector('[data-bill-field]');
		if (billInput instanceof HTMLInputElement) {
			const digitsOnly = (value) => value.replace(/\D/g, '').slice(0, LIMITS.monthlyBill);
			const formatBill = (digits) => (digits ? Number(digits).toLocaleString('en-NZ') : '');
			const cursorAfterDigits = (formatted, digitCount) => {
				if (digitCount <= 0) return 0;
				let seen = 0;
				for (let i = 0; i < formatted.length; i++) {
					if (/\d/.test(formatted[i])) {
						seen += 1;
						if (seen === digitCount) return i + 1;
					}
				}
				return formatted.length;
			};

			billInput.addEventListener('keydown', (event) => {
				if (event.ctrlKey || event.metaKey || event.altKey) return;
				if (event.key.length !== 1) return;
				if (!/\d/.test(event.key)) event.preventDefault();
			});

			billInput.addEventListener('beforeinput', (event) => {
				if (event.inputType === 'insertFromPaste' || event.inputType === 'insertFromDrop') return;
				if (event.data && /\D/.test(event.data)) event.preventDefault();
			});

			billInput.addEventListener('input', () => {
				const cursor = billInput.selectionStart;
				const digitsBefore = billInput.value.slice(0, cursor ?? 0).replace(/\D/g, '').length;
				const next = formatBill(digitsOnly(billInput.value));
				billInput.value = next;
				if (typeof cursor === 'number') {
					const pos = cursorAfterDigits(next, digitsBefore);
					billInput.setSelectionRange(pos, pos);
				}
			});
		}

		const emailInput = form.querySelector('[data-email-field]');
		if (emailInput instanceof HTMLInputElement) {
			emailInput.addEventListener('keydown', (event) => {
				if (event.key === ' ' || event.code === 'Space') event.preventDefault();
			});

			emailInput.addEventListener('input', () => {
				const cursor = emailInput.selectionStart;
				const next = emailInput.value.replace(/\s+/g, '').replace(/[^A-Za-z0-9.@_%+-]/g, '');
				if (next !== emailInput.value) {
					emailInput.value = next;
					if (typeof cursor === 'number') {
						emailInput.setSelectionRange(Math.min(cursor, next.length), Math.min(cursor, next.length));
					}
				}
			});

			emailInput.addEventListener('blur', () => {
				emailInput.value = sanitiseEmail(emailInput.value);
				if (emailInput.value && !isValidEmail(emailInput.value)) {
					showErrors(form, { email: 'Enter a valid email address.' });
					return;
				}
				if (emailInput.value) showErrors(form, {});
			});
		}

		const uploadInput = form.querySelector('[data-upload-input]');
		const fileField = form.querySelector('[data-file-field]');
		const filePick = form.querySelector('[data-file-pick]');
		const fileSummary = form.querySelector('[data-file-summary]');
		const fileClear = form.querySelector('[data-file-clear]');
		let billFile = null;
		let usageFile = null;
		const photos = [];

		const renderFiles = () => {
			const total = (billFile ? 1 : 0) + (usageFile ? 1 : 0) + photos.length;
			const imagesOnly = !billFile && !usageFile && photos.length > 0;

			if (filePick) filePick.textContent = total === 0 ? 'Upload files' : 'Add more';
			fileField?.classList.toggle('file-field--has-files', total > 0);

			if (fileSummary instanceof HTMLElement) {
				if (total === 0) {
					fileSummary.textContent = '';
					fileSummary.hidden = true;
				} else {
					fileSummary.hidden = false;
					fileSummary.textContent = imagesOnly
						? `${photos.length} image${photos.length === 1 ? '' : 's'}`
						: `${total} file${total === 1 ? '' : 's'}`;
				}
			}

			if (fileClear instanceof HTMLButtonElement) fileClear.hidden = total === 0;
		};

		fileClear?.addEventListener('click', () => {
			billFile = null;
			usageFile = null;
			photos.length = 0;
			if (uploadInput instanceof HTMLInputElement) uploadInput.value = '';
			renderFiles();
		});

		uploadInput?.addEventListener('change', async () => {
			if (!(uploadInput instanceof HTMLInputElement) || !uploadInput.files) return;

			const incoming = Array.from(uploadInput.files);
			uploadInput.value = '';

			for (const file of incoming) {
				if (isUsageFile(file)) {
					if (file.size > LIMITS.usageBytes) {
						showErrors(form, { uploads: 'The usage file must be under 5MB.' });
						continue;
					}
					usageFile = file;
					showErrors(form, {});
					renderFiles();
					continue;
				}

				if (isPdfFile(file)) {
					if (file.size > LIMITS.billBytes) {
						showErrors(form, { uploads: 'The bill must be under 8MB.' });
						continue;
					}
					billFile = file;
					showErrors(form, {});
					renderFiles();
					continue;
				}

				if (file.type.startsWith('image/')) {
					if (photos.length >= LIMITS.photos) {
						showErrors(form, { uploads: `Add ${LIMITS.photos} photos or fewer.` });
						continue;
					}
					if (file.size > LIMITS.photoBytes) {
						showErrors(form, { uploads: 'Each original photo must be under 12MB.' });
						continue;
					}

					try {
						photos.push(await compressImage(file));
						showErrors(form, {});
						renderFiles();
					} catch (error) {
						showErrors(form, {
							uploads:
								error instanceof Error && error.message === 'too-large'
									? 'That photo is still over 2MB after compressing. Try another image.'
									: 'Could not prepare that image. Try another file.',
						});
					}
					continue;
				}

				showErrors(form, {
					uploads: 'Use a PDF for the bill, a CSV or Excel file for usage or JPEG, PNG or WebP photos.',
				});
			}
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			form.querySelectorAll('[data-name-field]').forEach((input) => {
				if (input instanceof HTMLInputElement) input.value = sanitiseName(input.value);
			});
			if (phoneInput instanceof HTMLInputElement) {
				phoneInput.value = sanitisePhone(phoneInput.value);
			}

			if (emailInput instanceof HTMLInputElement) {
				emailInput.value = sanitiseEmail(emailInput.value);
			}
			if (messageInput instanceof HTMLTextAreaElement) {
				messageInput.value = capitaliseFirstLetter(messageInput.value);
			}

			const classified = classifyUploads(billFile, usageFile, photos);
			const { values, errors, ok } = validate(form, {
				photoCount: classified.photos.length,
				photos: classified.photos,
				bill: classified.bill,
				usage: classified.usage,
			});
			showErrors(form, errors);

			if (!ok) {
				const firstInvalid = form.querySelector('.field--invalid input, .field--invalid select, .field--invalid textarea');
				firstInvalid?.focus();
				return;
			}

			for (const [key, value] of Object.entries(values)) {
				const field = form.elements.namedItem(key);
				if (field && 'value' in field) field.value = value;
			}

			const submit = form.querySelector('button[type="submit"]');
			if (submit instanceof HTMLButtonElement) {
				submit.disabled = true;
				submit.textContent = 'Sending...';
				submit.dataset.label = 'Submit';
			}

			const payload = new FormData(form);
			payload.delete('uploads');
			payload.delete('photos');
			payload.delete('bill');
			payload.delete('usage');
			classified.photos.forEach((file, index) => {
				const ext = file.type === 'image/webp' ? 'webp' : 'jpg';
				payload.append('photos', file, `photo-${index + 1}.${ext}`);
			});
			if (classified.bill) {
				const billName = classified.bill.type === 'application/pdf' ? 'bill.pdf' : 'bill.webp';
				payload.append('bill', classified.bill, classified.bill.name || billName);
			}
			if (classified.usage) {
				payload.append('usage', classified.usage, classified.usage.name || 'usage.csv');
			}

			try {
				const response = await fetch(form.action, { method: 'POST', body: payload });
				if (response.redirected && /thank-you/.test(response.url)) {
					window.location.assign(response.url);
					return;
				}
				if (response.ok && !isHtmlResponse(response)) {
					window.location.assign('/thank-you/');
					return;
				}
				showErrors(form, {});
				showFormError(form, await messageFromResponse(response));
			} catch {
				showErrors(form, {});
				showFormError(form, 'Could not send enquiry. Check your connection and try again.');
			} finally {
				if (submit instanceof HTMLButtonElement) {
					submit.disabled = false;
					submit.textContent = submit.dataset.label || 'Submit';
				}
			}
		});
	});
</script>
