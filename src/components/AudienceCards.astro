---
import { audiences } from '../data/site';

const optimized = (image: string) => {
	const base = image
		.replace(/^\/images\//, '')
		.replace(/\.(png|jpe?g|webp)$/i, '')
		.replace(/-(?:640|960|1200|1600)$/i, '');
	return {
		src: `/images/${base}-960.webp`,
		srcset: `/images/${base}-640.webp 640w, /images/${base}-960.webp 960w`,
	};
};
---

<div class="audience-grid">
	{
		audiences.map((audience, index) => {
			const media = optimized(audience.image);
			return (
			<a
				class="audience-card"
				href={audience.href}
				data-reveal
				style={`--reveal-delay: ${index * 90}ms`}
			>
				<div class="audience-card__media">
					<img
						src={media.src}
						srcset={media.srcset}
						sizes="(max-width: 900px) 100vw, 33vw"
						alt={audience.alt}
						width="960"
						height="540"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="audience-card__content">
					<span class="eyebrow">{audience.eyebrow}</span>
					<h3>{audience.title}</h3>
					<span class="text-link">Explore</span>
				</div>
			</a>
			);
		})
	}
</div>

