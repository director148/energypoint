---
interface Props {
	title?: string;
	copy?: string;
	label?: string;
	audience?: string;
}

const {
	title = 'Let’s design energy around you.',
	copy = 'Start with a clear conversation about your property, your energy use and what you want to achieve.',
	label = 'Start your energy plan',
	audience,
} = Astro.props;

const href = audience ? `/contact/?audience=${encodeURIComponent(audience)}` : '/contact/';
---

<section class="cta-band">
	<div class="cta-band__inner" data-reveal>
		<div class="cta-band__copy">
			<h2>{title}</h2>
			<p>{copy}</p>
		</div>
		<a class="button button--light" href={href}>{label}</a>
	</div>
</section>
