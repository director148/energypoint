---
interface Props {
	title?: string;
	copy?: string;
	label?: string;
	audience?: string;
}

const {
	title = 'Book a free visit',
	copy = 'We come out, look at your property, energy bills and leave you with a plan. No pressure. Locally owned. People first.',
	label = 'Book a free visit',
	audience,
} = Astro.props;

const href = audience ? `/contact/?audience=${encodeURIComponent(audience)}` : '/contact/';
---

<section class="cta-band">
	<div class="cta-band__inner" data-reveal>
		<div class="cta-band__copy">
			<h2>{title}</h2>
			<p>{copy}</p>
		</div>
		<a class="button" href={href}>{label}</a>
	</div>
</section>
