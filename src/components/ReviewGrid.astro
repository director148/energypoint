---
import type { Review } from '../data/site';

interface Props {
	items: readonly Review[];
}

const { items } = Astro.props;
const total = items.length;

const attribution = (item: Review) =>
	[item.name, item.location].filter(Boolean).join(' · ');

const slideLabel = (index: number) =>
	`Review ${index + 1} of ${total}`;
---

<div class="review-grid" data-review-carousel data-reveal>
	<div
		class="review-carousel"
		data-review-viewport
		role="region"
		aria-roledescription="carousel"
		aria-label="Customer reviews"
	>
		<div class="review-carousel__container">
			{
				items.map((item, index) => (
					<div class="review-carousel__slide">
						<figure class="review-card" aria-label={slideLabel(index)}>
							<div
								class="review-card__stars"
								role="img"
								aria-label={`${item.rating ?? 5} out of 5 stars`}
							>
								{Array.from({ length: item.rating ?? 5 }).map(() => (
									<span aria-hidden="true">★</span>
								))}
							</div>
							{item.headline && <h3>{item.headline}</h3>}
							<blockquote>“{item.quote}”</blockquote>
							<figcaption>
								<span>{attribution(item)}</span>
							</figcaption>
						</figure>
					</div>
				))
			}
		</div>
	</div>

	{
		total > 1 && (
			<div class="review-carousel__controls">
				<button type="button" class="review-carousel__button" data-review-prev>
					<span class="sr-only">Previous review</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path d="M10.2 2.4 4.6 8l5.6 5.6" fill="none" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</button>
				<div class="review-carousel__dots" data-review-dots></div>
				<button type="button" class="review-carousel__button" data-review-next>
					<span class="sr-only">Next review</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path d="M5.8 2.4 11.4 8l-5.6 5.6" fill="none" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</button>
			</div>
		)
	}
</div>

<script>
	import EmblaCarousel, { type EmblaCarouselType } from 'embla-carousel';

	let teardown: (() => void) | undefined;

	const initReviewCarousels = () => {
		teardown?.();

		const instances: EmblaCarouselType[] = [];
		const abort = new AbortController();
		const { signal } = abort;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		document.querySelectorAll<HTMLElement>('[data-review-carousel]').forEach((root) => {
			const viewport = root.querySelector<HTMLElement>('[data-review-viewport]');
			const prev = root.querySelector<HTMLButtonElement>('[data-review-prev]');
			const next = root.querySelector<HTMLButtonElement>('[data-review-next]');
			const dotsRoot = root.querySelector<HTMLElement>('[data-review-dots]');

			if (!viewport) return;

			const embla = EmblaCarousel(viewport, {
				align: 'start',
				containScroll: 'trimSnaps',
				duration: reduceMotion ? 0 : 22,
				slidesToScroll: 1,
			});
			instances.push(embla);

			const syncButtons = () => {
				prev?.toggleAttribute('disabled', !embla.canScrollPrev());
				next?.toggleAttribute('disabled', !embla.canScrollNext());
			};

			const syncDots = () => {
				if (!dotsRoot) return;
				const snaps = embla.scrollSnapList();
				const selected = embla.selectedScrollSnap();

				if (dotsRoot.childElementCount !== snaps.length) {
					dotsRoot.replaceChildren(
						...snaps.map((_, index) => {
							const dot = document.createElement('button');
							dot.type = 'button';
							dot.className = 'review-carousel__dot';
							dot.setAttribute('aria-label', `Go to review group ${index + 1}`);
							dot.addEventListener('click', () => embla.scrollTo(index), { signal });
							return dot;
						}),
					);
				}

				[...dotsRoot.children].forEach((dot, index) => {
					dot.setAttribute('aria-current', index === selected ? 'true' : 'false');
				});
			};

			const sync = () => {
				syncButtons();
				syncDots();
			};

			sync();
			embla.on('select', sync);
			embla.on('reInit', sync);

			prev?.addEventListener('click', () => embla.scrollPrev(), { signal });
			next?.addEventListener('click', () => embla.scrollNext(), { signal });
		});

		teardown = () => {
			abort.abort();
			instances.forEach((embla) => embla.destroy());
		};
	};

	document.addEventListener('astro:page-load', initReviewCarousels);
</script>
