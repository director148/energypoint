---
interface Props {
	title: string;
	intro: string;
	image: string;
	alt: string;
	cta?: string;
	ctaHref?: string;
	ctaSecondary?: string;
	ctaSecondaryHref?: string;
	page?: boolean;
	position?: string;
	positionMobile?: string;
	chips?: readonly { label: string; href: string }[];
}

const {
	title,
	intro,
	image,
	alt,
	cta = 'Book a free visit',
	ctaHref = '/contact/',
	ctaSecondary = '',
	ctaSecondaryHref = '',
	page = false,
	position = 'center',
	positionMobile = '',
	chips = [],
} = Astro.props;

const imageBase = image
	.replace(/^\/images\//, '')
	.replace(/\.(png|jpe?g|webp)$/i, '');
const optimizedImage = `/images/${imageBase}-1200.webp`;
const optimizedSrcset = `/images/${imageBase}-640.webp 640w, /images/${imageBase}-960.webp 960w, /images/${imageBase}-1200.webp 1200w, /images/${imageBase}-1600.webp 1600w`;
---

<section
	class:list={['hero', page && 'hero--page']}
	style={`--hero-position: ${position};${positionMobile ? ` --hero-position-mobile: ${positionMobile};` : ''}`}
>
	<div class="hero__media">
		<img
			src={optimizedImage}
			srcset={optimizedSrcset}
			sizes="100vw"
			alt={alt}
			width="1920"
			height="1080"
			fetchpriority="high"
			decoding="async"
		/>
	</div>
	<div class="hero__content">
		<div class="hero__grid">
			<div class="hero__title">
				<h1 set:html={title} />
			</div>
			<div class="hero__aside">
				<p set:html={intro} />
				{
					chips.length > 0 && (
						<ul class="hero__chips">
							{chips.map((chip) => (
								<li>
									<a class="hero__chip" href={chip.href}>
										{chip.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
				<div class="hero__actions">
					<a class="button" href={ctaHref}>{cta}</a>
					{
						ctaSecondary && ctaSecondaryHref && (
							<a class="button button--ghost" href={ctaSecondaryHref}>
								{ctaSecondary}
							</a>
						)
					}
				</div>
			</div>
		</div>
	</div>
</section>
