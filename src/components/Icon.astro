---
type IconName =
	| 'savings'
	| 'monitor'
	| 'future'
	| 'support'
	| 'sun'
	| 'home'
	| 'building'
	| 'farm'
	| 'battery'
	| 'arrow'
	| 'search'
	| 'facebook'
	| 'instagram';

interface Props {
	name: IconName | string;
	size?: number;
}

const { name, size = 24 } = Astro.props;
const isFilled = name === 'facebook' || name === 'instagram';
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill={isFilled ? 'currentColor' : 'none'}
	stroke={isFilled ? 'none' : 'currentColor'}
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'savings' && (
			<>
				<path d="M4 7.5h16v11H4z" />
				<path d="M8 7.5V5.75A1.75 1.75 0 0 1 9.75 4h4.5A1.75 1.75 0 0 1 16 5.75V7.5" />
				<path d="M8.5 13h7M12 10.5v5" />
			</>
		)
	}
	{
		name === 'monitor' && (
			<>
				<rect x="3" y="4" width="18" height="13" rx="1.5" />
				<path d="M8 21h8M12 17v4M7 13l3-3 2 2 5-5" />
			</>
		)
	}
	{
		name === 'future' && (
			<>
				<path d="M12 3v18M5.5 6.5A8 8 0 0 1 20 12M18.5 17.5A8 8 0 0 1 4 12" />
				<path d="m17 8 3 4 2-4M7 16l-3-4-2 4" />
			</>
		)
	}
	{
		name === 'support' && (
			<>
				<circle cx="12" cy="12" r="8.5" />
				<path d="M8.5 12a3.5 3.5 0 1 1 4.8 3.23V17M13.3 17H16M5.3 7.7l3 3M18.7 7.7l-3 3" />
			</>
		)
	}
	{
		name === 'sun' && (
			<>
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
			</>
		)
	}
	{
		name === 'home' && (
			<>
				<path d="m3 11 9-8 9 8" />
				<path d="M5.5 9.5V21h13V9.5M9.5 21v-6h5v6" />
			</>
		)
	}
	{
		name === 'building' && (
			<>
				<path d="M5 21V5h9v16M14 10h5v11M8 8h3M8 12h3M8 16h3M16.5 13h.01M16.5 17h.01" />
			</>
		)
	}
	{
		name === 'farm' && (
			<>
				<path d="M3 21V10l9-6 9 6v11M7 21v-6h10v6M8 11h.01M12 11h.01M16 11h.01" />
			</>
		)
	}
	{
		name === 'battery' && (
			<>
				<rect x="3" y="6" width="17" height="12" rx="1.5" />
				<path d="M20 10h1.5v4H20M11 9l-2 3h3l-2 3" />
			</>
		)
	}
	{name === 'arrow' && <path d="M5 12h14M14 7l5 5-5 5" />}
	{
		name === 'search' && (
			<>
				<circle cx="11" cy="11" r="7" />
				<path d="m20 20-4-4" />
			</>
		)
	}
	{
		name === 'facebook' && (
			<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
		)
	}
	{
		name === 'instagram' && (
			<path
				fill-rule="evenodd"
				d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm8.5 1.7h-8.5A4.05 4.05 0 0 0 3.7 7.75v8.5A4.05 4.05 0 0 0 7.75 20.3h8.5a4.05 4.05 0 0 0 4.05-4.05v-8.5A4.05 4.05 0 0 0 16.25 3.7ZM12 7.1A4.9 4.9 0 1 1 7.1 12 4.9 4.9 0 0 1 12 7.1Zm0 1.7A3.2 3.2 0 1 0 15.2 12 3.2 3.2 0 0 0 12 8.8Zm5.05-3.15a1.15 1.15 0 1 1-1.15 1.15 1.15 1.15 0 0 1 1.15-1.15Z"
			/>
		)
	}
</svg>

