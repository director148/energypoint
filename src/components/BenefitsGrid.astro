---
import Icon from './Icon.astro';

interface Item {
	title: string;
	copy: string;
	icon?: string;
}

interface Props {
	items: readonly Item[];
}

const { items } = Astro.props;
---

<div class="benefit-grid">
	{
		items.map((item, index) => (
			<article
				class="benefit-card"
				data-reveal
				style={`--reveal-delay: ${index * 60}ms`}
			>
				<div class="benefit-card__icon">
					<Icon name={item.icon ?? 'sun'} />
				</div>
				<h3>{item.title}</h3>
				<p>{item.copy}</p>
			</article>
		))
	}
</div>

