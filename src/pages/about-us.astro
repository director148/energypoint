---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import { values } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About Energy Point"
	description="Independently Waikato-owned solar team. People first, no pressure, still here after switch-on."
	image="/images/about-team.png"
>
	<Hero
		page
		title="Locally owned. Waikato proud. People first"
		intro="Independent. You own the system.<br />We still answer the phone."
		image="/images/about-team.png"
		alt="The local Energy Point team in Waikato"
		cta="Book a free visit"
		ctaHref="/contact/"
		position="center 42%"
	/>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">How we work</span>
					<h2>Judgement first. Hardware second</h2>
				</div>
				<p class="lede muted">
					No sales fog. A plan you can decide on.
					<a class="text-link" href="/meet-the-team/">Meet the people</a>
				</p>
			</div>
			<div class="numbered-grid">
				{
					values.map((value, index) => (
						<article
							class="numbered-item"
							data-reveal
							style={`--reveal-delay: ${(index % 2) * 60}ms`}
						>
							<span class="numbered-item__number">
								{String(index + 1).padStart(2, '0')}
							</span>
							<div>
								<h3>{value.title}</h3>
								<p>{value.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Our ground</span>
					<h2>Hamilton, Cambridge and the properties between</h2>
				</div>
				<p class="lede muted">
					Te Awamutu, Morrinsville, Raglan and greater Waikato.
				</p>
			</div>
			<ul class="tag-list" aria-label="Energy Point service areas">
				<li>Hamilton</li>
				<li>Cambridge</li>
				<li>Te Awamutu</li>
				<li>Morrinsville</li>
				<li>Raglan</li>
				<li>Greater Waikato</li>
			</ul>
		</div>
	</section>

	<CTASection
		title="Let’s talk about your property"
		copy="Tell us how you use power today. We will come out with a plan, not a pitch."
		label="Book a free visit"
	/>
</BaseLayout>
