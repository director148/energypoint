---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import { values } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About Energy Point"
	description="Meet the thinking behind Energy Point: local Waikato energy expertise, personalised design, transparent advice and support for the long haul."
	image="/images/about-team.png"
>
	<Hero
		page
		eyebrow="About Energy Point"
		title="Local knowledge. Long-term thinking."
		intro="We are not here to push panels. We are here to understand the energy problem, design the right response and stay useful after installation."
		image="/images/about-team.png"
		alt="The local Energy Point team in Waikato"
		cta="Meet us on site"
		ctaHref="/contact/"
		position="center 42%"
	/>

	<section class="section section--cream">
		<div class="container intro-statement">
			<div>
				<span class="eyebrow">Our belief</span>
			</div>
			<div class="intro-statement__body" data-reveal>
				<p>
					Energy is personal. The system should be too.
				</p>
				<p class="lede muted">
					Every property has a different pattern of demand, physical constraints and
					ambition. So we begin with questions: When do you use the most power? What do you
					want to change? What will this property need in five or ten years?
				</p>
				<p class="lede muted">
					That understanding turns equipment into an energy plan — one built around how you
					live, work or operate.
				</p>
			</div>
		</div>
	</section>

	<section class="section section--dark">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">What we ask first</span>
					<h2>The questions behind a better system.</h2>
				</div>
				<p class="lede muted">
					Technology comes after context. These are the conversations that shape the design.
				</p>
			</div>
			<div class="metric-band">
				<div class="metric" data-reveal>
					<strong>When?</strong>
					<span>Do you use energy most?</span>
				</div>
				<div class="metric" data-reveal style="--reveal-delay: 80ms">
					<strong>Why?</strong>
					<span>Does the system need to exist?</span>
				</div>
				<div class="metric" data-reveal style="--reveal-delay: 160ms">
					<strong>Next?</strong>
					<span>Could the property need later?</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">What makes us different</span>
					<h2>Good work is as much about judgement as hardware.</h2>
				</div>
				<p class="lede muted">
					Our job is to make the technical picture clear enough for you to make a confident
					decision.
				</p>
			</div>
			<div class="numbered-grid">
				{
					values.map((value, index) => (
						<article
							class="numbered-item"
							data-reveal
							style={`--reveal-delay: ${(index % 2) * 60}ms`}
						>
							<span class="numbered-item__number">
								{String(index + 1).padStart(2, '0')}
							</span>
							<div>
								<h3>{value.title}</h3>
								<p>{value.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="media-split">
		<div class="media-split__media">
			<img
				src="/images/about-team-1600.webp"
				alt="Energy Point people bringing practical energy advice to Waikato properties"
				width="1480"
				height="832"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="media-split__content">
			<span class="eyebrow">Real people, honest advice</span>
			<h2>A local team for the whole energy journey.</h2>
			<p class="lede">
				We work with homeowners, farmers, business owners and community organisations across
				the Waikato. The common thread is practical advice, high-standard work and no sales
				fog.
			</p>
			<ul class="feature-list">
				<li>Residential property</li>
				<li>Commercial operations</li>
				<li>Farms and lifestyle blocks</li>
				<li>Maintenance and upgrades</li>
			</ul>
			<a class="button button--ghost" href="/contact/">Start a conversation</a>
		</div>
	</section>

	<section class="section section--cream">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Waikato, our home ground</span>
					<h2>Close enough to understand the place. Serious enough to plan beyond it.</h2>
				</div>
				<p class="lede muted">
					From Hamilton and Cambridge to Raglan, Te Awamutu, Morrinsville and the
					properties between them, we bring regional knowledge to future-ready energy.
				</p>
			</div>
			<ul class="tag-list" aria-label="Energy Point service areas">
				<li>Hamilton</li>
				<li>Cambridge</li>
				<li>Te Awamutu</li>
				<li>Morrinsville</li>
				<li>Raglan</li>
				<li>Greater Waikato</li>
			</ul>
		</div>
	</section>

	<CTASection
		eyebrow="Start with your property"
		title="Let’s build the plan that belongs here."
		copy="Tell us how the property works today and where you want it to go. We will start with the right questions."
		label="Talk with Energy Point"
	/>
</BaseLayout>

