---
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const nextSteps = [
	{
		number: '01',
		title: 'We listen',
		copy: 'We review what you sent.',
		icon: 'support',
	},
	{
		number: '02',
		title: 'We clarify',
		copy: 'We ask only for useful details.',
		icon: 'monitor',
	},
	{
		number: '03',
		title: 'Next step',
		copy: 'Site visit, review or advice.',
		icon: 'arrow',
	},
] as const;
---

<BaseLayout
	title="Start Your Energy Plan"
	description="Talk with Energy Point about residential, commercial, rural or maintenance needs across Waikato. Start with a no-pressure project conversation."
	image="/images/process-consultation.jpg"
>
	<section class="hero hero--contact" style="--hero-position: 70% 42%;">
		<div class="hero__media">
			<img
				src="/images/process-consultation-1200.webp"
				srcset="/images/process-consultation-640.webp 640w, /images/process-consultation-960.webp 960w, /images/process-consultation-1200.webp 1200w, /images/process-consultation-1600.webp 1600w"
				sizes="100vw"
				alt="An Energy Point specialist meeting a Waikato homeowner on site"
				width="1920"
				height="1080"
				fetchpriority="high"
				decoding="async"
			/>
		</div>
		<div class="hero__content">
			<div class="contact-stage">
				<div class="contact-stage__intro">
					<div>
						<h1>Tell us about your property.</h1>
						<p class="lede muted">
							What you use, what you want to change, and what a better setup should achieve.
							We will come back with a practical next step.
						</p>
					</div>
					<div class="contact-details">
						<a class="button button--light" href={site.phoneHref}>{site.phoneDisplay}</a>
						<a class="button button--ghost" href={`mailto:${site.email}`}>{site.email}</a>
						<span class="muted">{site.region}</span>
					</div>
				</div>
				<ContactForm />
			</div>
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<span class="eyebrow">What happens next</span>
					<h2>Three clear steps.</h2>
				</div>
			</div>
			<ol class="next-steps">
				{
					nextSteps.map((step) => (
						<li class="next-steps__item">
							<span class="next-steps__icon" aria-hidden="true">
								<Icon name={step.icon} size={22} />
							</span>
							<span class="next-steps__number">{step.number}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>
</BaseLayout>
