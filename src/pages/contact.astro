---
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Start Your Energy Plan"
	description="Talk with Energy Point about residential, commercial, rural or maintenance needs across Waikato. Start with a no-pressure project conversation."
>
	<section
		class="section section--dark"
		style="padding-top: clamp(10rem, 18vw, 15rem); min-height: 100svh;"
	>
		<div class="container contact-stage">
			<div class="contact-stage__intro">
				<div>
					<span class="eyebrow">Start your energy plan</span>
					<h1>Tell us what better energy looks like.</h1>
					<p class="lede muted">
						Share the property, the problem and the outcome you want. We will come back
						with a practical next step, not a generic package.
					</p>
				</div>
				<div class="contact-details">
					<span class="eyebrow">Prefer direct?</span>
					<a href={site.phoneHref}>{site.phoneDisplay}</a>
					<a href={`mailto:${site.email}`}>{site.email}</a>
					<span class="muted">{site.region}</span>
				</div>
			</div>
			<ContactForm />
		</div>
	</section>

	<section class="section section--cream">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">What happens next</span>
					<h2>A useful conversation, then a clear path.</h2>
				</div>
				<p class="lede muted">
					We review your enquiry, ask for the information that actually matters and arrange
					a site conversation where appropriate.
				</p>
			</div>
			<div class="three-up">
				<article class="editorial-card">
					<span class="editorial-card__number">01</span>
					<h3>We listen</h3>
					<p>Someone from the Energy Point team reviews the context you have provided.</p>
				</article>
				<article class="editorial-card">
					<span class="editorial-card__number">02</span>
					<h3>We clarify</h3>
					<p>We ask for useful details such as an energy bill, site access or system history.</p>
				</article>
				<article class="editorial-card">
					<span class="editorial-card__number">03</span>
					<h3>We define the next step</h3>
					<p>That may be a site visit, technical review, maintenance booking or early advice.</p>
				</article>
			</div>
		</div>
	</section>
</BaseLayout>

