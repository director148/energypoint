---
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { people, reviews, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const audienceParam = Astro.url.searchParams.get('audience') || '';

const nick = people[0];
const trustReviews = [reviews[0], reviews[5]];

const nextSteps = [
	{
		title: 'We call you',
		copy: 'Within one working day.',
		icon: 'support',
	},
	{
		title: 'Site visit',
		copy: 'We walk the property with you. No pitch on the doorstep.',
		icon: 'home',
	},
	{
		title: 'Options to take home',
		copy: 'A plan you can sit with. No pressure to sign that day.',
		icon: 'monitor',
	},
] as const;
---

<BaseLayout
	title="Book a free visit"
	description="Book a Waikato property visit with Energy Point. Nick walks the place with you and you leave with clear options. No pressure to sign."
>
	<section id="enquiry" class="section section--cream section--compact contact-section">
		<div class="container">
			<div class="contact-heading">
				<h1>Book a free visit</h1>
			</div>
			<ol class="next-steps">
				{
					nextSteps.map((step) => (
						<li class="next-steps__item">
							<span class="next-steps__icon" aria-hidden="true">
								<Icon name={step.icon} size={22} />
							</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</div>
						</li>
					))
				}
			</ol>
			<div class="contact-stage">
				<div class="contact-stage__form">
					<ContactForm defaultAudience={audienceParam} />
				</div>
				<aside class="contact-rail" aria-label="Why book with Energy Point">
					{
						nick.image && (
							<div class="contact-rail__person">
								<img
									src={nick.image.replace(/\.(png|jpe?g)$/i, '-960.webp')}
									srcset={`${nick.image.replace(/\.(png|jpe?g)$/i, '-640.webp')} 640w, ${nick.image.replace(/\.(png|jpe?g)$/i, '-960.webp')} 960w`}
									sizes="(max-width: 64rem) 100vw, 22rem"
									alt={nick.alt}
									width="960"
									height="640"
								/>
								<div>
									<span class="eyebrow">{nick.role}</span>
									<h2>{nick.name}</h2>
									<p>{nick.copy}</p>
								</div>
							</div>
						)
					}
					<ul class="contact-rail__quotes">
						{
							trustReviews.map((review) => (
								<li>
									<blockquote>{review.headline ?? review.quote}</blockquote>
									<p>
										{review.name}
										{review.location ? ` · ${review.location}` : ''}
									</p>
								</li>
							))
						}
					</ul>
					<p class="contact-rail__phone">
						Rather talk now?
						<a href={site.phoneHref}>{site.phoneDisplay}</a>
						<span>{site.hours}</span>
					</p>
				</aside>
			</div>
		</div>
	</section>
</BaseLayout>
