---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Enquiry Received"
	description="Thank you for contacting Energy Point."
	noindex
>
	<section
		class="section section--dark"
		style="display: grid; min-height: 100svh; place-items: center; padding-top: 10rem; text-align: center;"
	>
		<div class="narrow" data-reveal>
			<span class="eyebrow">Enquiry received</span>
			<h1 style="max-width: 11ch; margin-inline: auto;">Good energy starts with a conversation.</h1>
			<p class="lede muted" style="margin-inline: auto; margin-bottom: 2rem;">
				Thanks for giving us the context. The Energy Point team will review your enquiry and
				get in touch with a practical next step.
			</p>
			<a class="button button--light" href="/">Back to Energy Point</a>
		</div>
	</section>
</BaseLayout>

