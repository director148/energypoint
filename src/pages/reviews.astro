---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import ReviewGrid from '../components/ReviewGrid.astro';
import { reviews, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const reviewSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: site.name,
	url: site.url,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: '5',
		bestRating: '5',
		reviewCount: String(reviews.length),
	},
	review: reviews.map((item) => ({
		'@type': 'Review',
		author: { '@type': 'Person', name: item.name },
		reviewBody: item.quote,
		name: item.headline,
		reviewRating: {
			'@type': 'Rating',
			ratingValue: String(item.rating ?? 5),
			bestRating: '5',
		},
	})),
};
---

<BaseLayout
	title="Customer Reviews"
	description="What Waikato homeowners say about Energy Point: clear advice, no pressure and support that lasts."
	image="/images/process-consultation-1600.webp"
	schema={reviewSchema}
>
	<Hero
		page
		title="Reviews"
		intro="From first chat to aftercare.<br />This is what customers say."
		image="/images/process-consultation.webp"
		alt="Energy Point meeting a Waikato homeowner on site"
		cta="Book a free visit"
		ctaHref="/contact/"
		position="center 42%"
		positionMobile="center 38%"
	/>

	<section class="section section--cream section--compact">
		<div class="container">
			<ReviewGrid items={reviews} />
		</div>
	</section>

	<CTASection
		title="See if solar fits your property"
		copy="Start with a no-pressure conversation about how you use energy and what you want the system to do."
		label="Book a free visit"
	/>
</BaseLayout>
