---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page Not Found"
	description="The page you were looking for could not be found."
	noindex
	headerOnLight
>
	<section
		class="section section--cream"
		style="display: grid; min-height: 100svh; place-items: center; padding-top: 10rem; text-align: center;"
	>
		<div class="narrow">
			<span class="eyebrow">404 · Off-grid</span>
			<h1 style="max-width: 9ch; margin-inline: auto;">This page is not generating</h1>
			<p class="lede muted" style="margin-inline: auto; margin-bottom: 2rem;">
				The address may have changed or the page may never have existed.
			</p>
			<a class="button" href="/">Return home</a>
		</div>
	</section>
</BaseLayout>

