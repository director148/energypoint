---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import { financeBenefits, financeOptions, financeReviewed } from '../data/finance';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Solar Finance New Zealand"
	description="Current New Zealand green lending pathways that may help eligible customers finance solar. Date-stamped. Confirm terms with the lender."
	image="/images/finance-hero.jpg"
>
	<Hero
		page
		title="Finance"
		intro="We size the system first.<br />Take the plan to your lender."
		image="/images/finance-hero.jpg"
		alt="A homeowner considering finance for a solar energy system"
		cta="Book a free visit"
		ctaHref="/contact/?audience=Residential"
		position="center 45%"
	/>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<h2>Spread the cost</h2>
					<p>
						Keep cash in the household. The system can earn while you repay the lending.
					</p>
				</div>
			</div>
			<div class="reason-grid">
				{
					financeBenefits.map((reason, index) => (
						<article
							class="reason-card"
							data-reveal
							style={`--reveal-delay: ${index * 40}ms`}
						>
							<span class="reason-card__number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{reason.title}</h3>
								<p>{reason.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Current funding</span>
					<h2>Green lending from major banks</h2>
				</div>
				<p class="lede muted">
					If you already have a home loan, a green top-up is often the simplest path. We
					size the system. You take the plan to your bank.
				</p>
			</div>

			<div class="finance-list">
				{
					financeOptions.map((option) => (
						<a
							class="finance-row"
							href={option.source}
							target="_blank"
							rel="noreferrer"
						>
							<span class="finance-row__logo">
								<img src={option.logo} alt="" width="180" height="180" />
							</span>
							<span class="finance-row__provider">{option.provider}</span>
							<span class="finance-row__product">{option.product}</span>
							<span class="finance-row__rate">{option.rate}<br />{option.term}</span>
							<span class="finance-row__limit">{option.limit}</span>
							<span class="finance-row__arrow" aria-hidden="true">↗</span>
							<span class="sr-only"> (opens official lender website)</span>
						</a>
					))
				}
			</div>

			<p class="finance-footnote">
				These products are offered by independent lenders, not Energy Point. Lending,
				equity, credit and product criteria apply. Promotional rates can revert. Energy
				Point does not provide financial advice. As of August 2026 there is no nationwide
				government rebate for residential rooftop solar. Election policies are proposals,
				not current entitlements. Information reviewed {financeReviewed}.
			</p>
		</div>
	</section>

	<CTASection
		title="Need a hand choosing?"
		copy="Book a visit. We size the system and give you numbers you can take to the bank."
		label="Book a free visit"
	/>
</BaseLayout>
