---
import AudienceCards from '../components/AudienceCards.astro';
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import ProcessIndex from '../components/ProcessIndex.astro';
import ReviewGrid from '../components/ReviewGrid.astro';
import { audiences, reviews } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Solar and smart energy design',
	provider: { '@type': 'LocalBusiness', name: 'Energy Point' },
	areaServed: 'Waikato, New Zealand',
	serviceType: ['Residential solar', 'Commercial solar', 'Rural solar', 'Solar maintenance'],
};
---

<BaseLayout
	title="Energy Point"
	description="Solar for Waikato homes, businesses and rural properties. Designed, installed and supported by a local team. No pressure."
	schema={serviceSchema}
>
	<Hero
		title="Solar for<br />the Waikato"
		intro="We come out and leave you a plan.<br />Locally owned. People first."
		image="/images/home-hero.jpg"
		alt="An Energy Point solar installation on a Waikato home"
		position="center 48%"
		cta="Book a free visit"
		chips={audiences.map((audience) => ({ label: audience.title, href: audience.href }))}
	/>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<span class="eyebrow">Designed around you</span>
					<h2>Clear advice, no pressure</h2>
				</div>
			</div>
			<ReviewGrid items={reviews} />
		</div>
	</section>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading section-heading--oneline">
				<div>
					<span class="eyebrow">Where we work</span>
					<h2>Home, business or land</h2>
				</div>
			</div>
			<AudienceCards />
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<span class="eyebrow">How it works</span>
					<h2>Five steps</h2>
					<p>Visit, design, install, grid connection, support.</p>
				</div>
			</div>
			<ProcessIndex />
		</div>
	</section>

	<CTASection />
</BaseLayout>
