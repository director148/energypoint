---
import AudienceCards from '../components/AudienceCards.astro';
import BenefitsGrid from '../components/BenefitsGrid.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Hero from '../components/Hero.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import ReviewGrid from '../components/ReviewGrid.astro';
import { featuredFaqs } from '../data/faqs';
import { featuredReviews, homeBenefits } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Solar and smart energy design',
	provider: { '@type': 'LocalBusiness', name: 'Energy Point' },
	areaServed: 'Waikato, New Zealand',
	serviceType: ['Residential solar', 'Commercial solar', 'Rural solar', 'Solar maintenance'],
};
---

<BaseLayout
	title="Energy Point"
	description="Smart solar and personalised energy plans for Waikato homes, businesses and rural properties. Designed, installed and supported by a local team."
	schema={serviceSchema}
>
	<Hero
		title="Energy, designed around you."
		intro="We understand how you use power, then design a future-ready system that makes it work harder for your home, business or land."
		image="/images/home-hero.jpg"
		alt="An Energy Point solar installation on a Waikato home"
		position="center 48%"
	/>

	<section class="section section--cream">
		<div class="container intro-statement">
			<div>
				<span class="eyebrow">Our point of view</span>
			</div>
			<div class="intro-statement__body" data-reveal>
				<p>
					The future of energy is not bought off a shelf. It is designed around the way
					you live, work and grow.
				</p>
				<p class="lede muted">
					We start with your usage, your property and your plans. Solar may be part of
					the answer. Batteries, EV charging, monitoring and smarter habits may be too.
					The point is to build the right energy plan, not simply sell more panels.
				</p>
				<a class="text-link" href="/about-us/">Why Energy Point</a>
			</div>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Built for the Waikato</span>
					<h2>One region. Three very different energy realities.</h2>
				</div>
				<p class="lede muted">
					From a family home in Cambridge to a Hamilton workshop or a dairy operation
					outside Te Awamutu, every design begins with the place it has to perform.
				</p>
			</div>
			<AudienceCards />
		</div>
	</section>

	<section class="section section--dark">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">The Energy Point method</span>
					<h2>One team, from first question to long-term care.</h2>
				</div>
				<p class="lede muted">
					Clear advice, disciplined design, professional installation and support that
					does not disappear after switch-on.
				</p>
			</div>
			<ProcessTimeline />
		</div>
	</section>

	<section class="section section--cream">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">A smarter energy position</span>
					<h2>Control more of what happens behind your meter.</h2>
				</div>
				<p class="lede muted">
					A well-designed system gives you more than generation. It gives you visibility,
					options and a practical path into what comes next.
				</p>
			</div>
			<BenefitsGrid items={homeBenefits} />
		</div>
	</section>

	<section class="media-split">
		<div class="media-split__media">
			<img
				src="/images/home-detail-1600.webp"
				alt="Energy Point solar technology installed for a local property"
				width="1920"
				height="1080"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="media-split__content">
			<span class="eyebrow">More than panels</span>
			<h2>Built for the whole energy picture.</h2>
			<p class="lede">
				The best system is the one that fits today without boxing you out of tomorrow.
				That means thinking about changing demand, storage, transport and the technology
				already on its way.
			</p>
			<ul class="feature-list">
				<li>Solar generation</li>
				<li>Battery readiness</li>
				<li>EV charging</li>
				<li>Monitoring and optimisation</li>
			</ul>
			<a class="button button--ghost" href="/residential/">Explore home energy</a>
		</div>
	</section>

	<section class="media-split media-split--reverse">
		<div class="media-split__media">
			<img
				src="/images/finance-hero-1600.webp"
				alt="A considered path to financing a solar energy system"
				width="1920"
				height="1280"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="media-split__content">
			<span class="eyebrow">Finance without the fog</span>
			<h2>Good energy should make financial sense.</h2>
			<p class="lede">
				Several New Zealand banks offer green lending for eligible customers. We help you
				understand the technical investment; your lender confirms the finance that is
				right for you.
			</p>
			<ul class="feature-list">
				<li>Current lender options</li>
				<li>Clear eligibility caveats</li>
				<li>No imaginary government rebates</li>
			</ul>
			<a class="button" href="/finance/">See current finance pathways</a>
		</div>
	</section>

	<section class="section section--forest">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Customer reviews</span>
					<h2>What customers say after the install.</h2>
				</div>
				<p class="lede muted">
					What Waikato homeowners say after working with Energy Point, from first chat
					to switch-on.
				</p>
			</div>
			<ReviewGrid items={featuredReviews} />
			<p style="margin-top: 2rem;">
				<a class="text-link" href="/reviews/">Read every review</a>
			</p>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container faq-layout">
			<div class="faq-intro">
				<span class="eyebrow">Straight answers</span>
				<h2>Solar, without the sales fog.</h2>
				<p class="muted">
					Start with the questions most Waikato property owners ask us.
				</p>
				<a class="text-link" href="/frequently-asked-questions/">View all questions</a>
			</div>
			<FAQAccordion items={featuredFaqs} />
		</div>
	</section>

	<CTASection />
</BaseLayout>
