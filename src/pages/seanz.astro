---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import { seanzBenefits, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="SEANZ member"
	description="Energy Point is a SEANZ member. Vetted listing, a code of conduct, green lending pathways and a named electrical inspector."
>
	<Hero
		page
		title="SEANZ"
		intro="A vetted installer.<br />A listing you can check."
		image="/images/about-us-hero.jpg"
		alt="Energy Point, Waikato solar and energy plans"
		cta="Book a free visit"
		ctaHref="/contact/"
		position="center 42%"
	/>

	<section class="membership">
		<div class="membership__brand">
			<img
				src={site.seanzLogo}
				alt="SEANZ, Sustainable Energy Association of New Zealand"
				width="481"
				height="162"
				decoding="async"
			/>
			<p>
				Energy Point is a member. Alan Gellert is listed as our inspector. The listing is
				public, so you can check who we are before we visit.
			</p>
			<a class="text-link" href={site.seanz} target="_blank" rel="noreferrer">
				View our SEANZ listing
			</a>
		</div>
		<div class="membership__content">
			<span class="eyebrow">Industry body</span>
			<h2>Why a SEANZ installer</h2>
			<p class="lede muted">
				SEANZ is the trade body for solar and energy storage in New Zealand. Using a member
				is how you get a vetted installer, a code of conduct and the bank pathways that sit
				behind green lending.
			</p>
			<div class="reason-grid">
				{
					seanzBenefits.map((reason, index) => (
						<article
							class="reason-card"
							data-reveal
							style={`--reveal-delay: ${index * 40}ms`}
						>
							<span class="reason-card__number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{reason.title}</h3>
								<p>{reason.copy}</p>
							</div>
						</article>
					))
				}
			</div>
			<a class="text-link" href="/finance/">Current green lending</a>
		</div>
	</section>

	<CTASection
		title="Meet us on your property"
		copy="A free visit. We look at the property and the bill and leave you with a plan. No pressure."
		label="Book a free visit"
	/>
</BaseLayout>
