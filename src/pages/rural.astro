---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import ProcessIndex from '../components/ProcessIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const ruralReasons = [
	{
		title: 'Lower farm power costs',
		copy: 'Daytime power you no longer buy.',
	},
	{
		title: 'Match daytime loads',
		copy: 'Generation when pumps and plant are working.',
	},
	{
		title: 'Use shed roof space',
		copy: 'Turn clear roof area into useful generation.',
	},
	{
		title: 'Ground mount where needed',
		copy: 'Use open land when the roofs do not suit.',
	},
	{
		title: 'Plan for seasonal peaks',
		copy: 'Design for the months that drive the bill.',
	},
	{
		title: 'Cleaner farm energy',
		copy: 'Lower-carbon power for the whole operation.',
	},
	{
		title: 'Ready for a battery',
		copy: 'Add storage now or make room for it later.',
	},
	{
		title: 'Local support',
		copy: 'A Waikato team that keeps answering.',
	},
] as const;

const ruralSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Rural and agricultural solar systems',
	serviceType: 'Rural solar design and installation',
	areaServed: 'Waikato, New Zealand',
};
---

<BaseLayout
	title="Rural Solar Waikato"
	description="Rural solar for Waikato farms and lifestyle blocks. We walk the property and design around sheds, pumps, workshops and land."
	image="/images/rural-hero.png"
	schema={ruralSchema}
>
	<Hero
		page
		title="Rural"
		intro="Sheds, pumps and seasonal loads.<br />Then leave a plan."
		image="/images/rural-hero.png"
		alt="Ground-mounted solar panels on a rural Waikato property"
		cta="Book a free visit"
		ctaHref="/contact/?audience=Rural"
		position="center 48%"
	/>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<h2>Built for the farm</h2>
					<p>
						Sheds, pumps and seasonal loads. Use the roof or the land, where it fits.
					</p>
				</div>
			</div>
			<div class="reason-grid">
				{
					ruralReasons.map((reason, index) => (
						<article
							class="reason-card"
							data-reveal
							style={`--reveal-delay: ${index * 40}ms`}
						>
							<span class="reason-card__number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{reason.title}</h3>
								<p>{reason.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<span class="eyebrow">How it works</span>
					<h2>From first chat to the grid</h2>
				</div>
			</div>
			<ProcessIndex />
		</div>
	</section>

	<CTASection
		audience="Rural"
		title="Book a free visit for the farm"
		copy="Start with a no-pressure conversation about the property, the bills and what you want next."
		label="Book a free visit"
	/>
</BaseLayout>
