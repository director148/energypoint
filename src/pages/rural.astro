---
import BenefitsGrid from '../components/BenefitsGrid.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Hero from '../components/Hero.astro';
import QuoteGrid from '../components/QuoteGrid.astro';
import { featuredFaqs } from '../data/faqs';
import { testimonials } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const benefits = [
	{
		title: 'Offset daytime load',
		copy: 'Match generation to sheds, pumps, workshops and other productive demand.',
		icon: 'sun',
	},
	{
		title: 'Use roof or ground',
		copy: 'Consider available structures and ground-mounted options around real farm access.',
		icon: 'farm',
	},
	{
		title: 'Plan for resilience',
		copy: 'Assess storage and system architecture around critical rural loads.',
		icon: 'battery',
	},
	{
		title: 'Keep it serviceable',
		copy: 'Design for safe access, monitoring, cleaning and long-term maintenance.',
		icon: 'support',
	},
];

const ruralSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Rural and agricultural solar systems',
	serviceType: 'Rural solar design and installation',
	areaServed: 'Waikato, New Zealand',
};
---

<BaseLayout
	title="Rural Solar Waikato"
	description="Rural solar for Waikato farms and lifestyle blocks, designed around sheds, pumps, workshops, land, reliability and future demand."
	image="/images/rural-hero.png"
	schema={ruralSchema}
>
	<Hero
		page
		eyebrow="Rural energy"
		title="Put your land to work twice."
		intro="Solar designed around the demands of rural life — from dairy sheds and pumps to workshops, worker accommodation and ground-mounted systems."
		image="/images/rural-hero.png"
		alt="Ground-mounted solar panels on a rural Waikato property"
		cta="Book a rural site review"
		ctaHref="/contact/?audience=Rural"
		position="center 48%"
	/>

	<section class="section section--cream">
		<div class="container intro-statement">
			<div>
				<span class="eyebrow">Rural by design</span>
			</div>
			<div class="intro-statement__body" data-reveal>
				<p>
					A farm is not a large house. Its energy system should not be designed like one.
				</p>
				<p class="lede muted">
					Pumps, cooling, milking, workshops, accommodation and long cable runs create
					distinct demand and reliability questions. We visit the property, understand the
					operation and design around the loads that matter.
				</p>
			</div>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Why rural solar works</span>
					<h2>Daylight and productive demand often arrive together.</h2>
				</div>
				<p class="lede muted">
					The opportunity is real — but only when site, load and long-term serviceability
					are considered together.
				</p>
			</div>
			<BenefitsGrid items={benefits} />
		</div>
	</section>

	<section class="media-split">
		<div class="media-split__media">
			<img
				src="/images/rural-hero-1600.webp"
				alt="Solar array positioned on open rural land"
				width="1920"
				height="1080"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="media-split__content">
			<span class="eyebrow">Roof or ground</span>
			<h2>Use the best part of the property.</h2>
			<p class="lede">
				Not every roof has the right orientation, structure or access. A ground-mounted
				array can offer scale, maintenance access and flexibility — provided it works with
				stock, vehicles, drainage and daily operations.
			</p>
			<ul class="feature-list">
				<li>Roof and structure review</li>
				<li>Ground-array siting</li>
				<li>Access and farm-flow planning</li>
				<li>Network and cable considerations</li>
			</ul>
			<a class="button button--ghost" href="/contact/?audience=Rural">
				Assess my property
			</a>
		</div>
	</section>

	<section class="section section--cream">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Where solar earns its place</span>
					<h2>Designed around useful rural work.</h2>
				</div>
				<p class="lede muted">
					We map generation against the operation instead of assuming every kilowatt-hour
					has equal value.
				</p>
			</div>
			<div class="numbered-grid">
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">01</span>
					<div>
						<h3>Dairy sheds</h3>
						<p>Consider cooling, hot water, pumps and the timing of milking demand.</p>
					</div>
				</article>
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">02</span>
					<div>
						<h3>Irrigation and pumping</h3>
						<p>Explore generation that aligns with high daytime seasonal loads.</p>
					</div>
				</article>
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">03</span>
					<div>
						<h3>Woolsheds and workshops</h3>
						<p>Use suitable roof area to support regular operating demand.</p>
					</div>
				</article>
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">04</span>
					<div>
						<h3>Homes and accommodation</h3>
						<p>Connect household use to the wider property energy strategy.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="media-split media-split--reverse">
		<div class="media-split__media">
			<img
				src="/images/finance-hero-1600.webp"
				alt="Planning finance for a rural solar investment"
				width="1920"
				height="1280"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="media-split__content">
			<span class="eyebrow">Capital with context</span>
			<h2>Make the finance fit the operation.</h2>
			<p class="lede">
				Green lending and business finance may help eligible rural customers manage upfront
				cost. We provide the technical scope and assumptions; your lender or adviser confirms
				the right financial structure.
			</p>
			<a class="button" href="/finance/">Review current pathways</a>
		</div>
	</section>

	<section class="section section--forest">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Rural customer perspective</span>
					<h2>Practical advice from people who came to the property.</h2>
				</div>
				<p class="lede muted">
					What rural customers say after we walked the property with them.
				</p>
			</div>
			<QuoteGrid items={testimonials.rural} />
			<p style="margin-top: 2rem;">
				<a class="text-link" href="/reviews/">Read more reviews</a>
			</p>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container faq-layout">
			<div class="faq-intro">
				<span class="eyebrow">Rural solar questions</span>
				<h2>Start with the practical detail.</h2>
				<a class="text-link" href="/frequently-asked-questions/">View all FAQs</a>
			</div>
			<FAQAccordion items={featuredFaqs.slice(0, 4)} />
		</div>
	</section>

	<CTASection
		audience="Rural"
		eyebrow="Free rural site review"
		title="Walk the property with an energy specialist."
		copy="Show us how the operation works. We will help identify where solar could earn its place."
		label="Book my site review"
	/>
</BaseLayout>

