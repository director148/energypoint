---
import BenefitsGrid from '../components/BenefitsGrid.astro';
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const carePaths = [
	{
		title: 'Fast, reliable repairs',
		copy: 'Inverter, panel damage or a drop in generation. We find the cause and get the system back on track with little downtime.',
		image: '/images/process-support.jpg',
		alt: 'Energy Point specialist investigating a solar system issue',
		position: 'center 48%',
	},
	{
		title: 'Upgrade the system',
		copy: 'Better components, more panels, batteries or monitoring. We design around what is already on the roof, then install it.',
		image: '/images/social/fb-122159651738654298.jpg',
		alt: 'Home battery storage installed beside a Waikato house',
		position: 'center center',
	},
	{
		title: 'Proactive maintenance',
		copy: 'Regular inspections catch small issues before they become downtime. We look after systems we did not install too.',
		image: '/images/maintenance-check.jpg',
		alt: 'Energy Point technician on a ladder measuring a Waikato roof',
		position: 'center 42%',
	},
];

const whyItMatters = [
	{
		title: 'Maximise energy output',
		copy: 'Keep the panels performing at their best.',
	},
	{
		title: 'Prevent costly repairs',
		copy: 'Catch small issues before they become big ones.',
	},
	{
		title: 'Protect the investment',
		copy: 'A system that keeps earning for the long term.',
	},
	{
		title: 'Stay warranty-ready',
		copy: 'Keep product warranties in good standing.',
	},
	{
		title: 'Prevent damage',
		copy: 'Dirt, birds and weather wear. Spot it early.',
	},
	{
		title: 'Peace of mind',
		copy: 'A local team still looking after the system.',
	},
] as const;

const maintenanceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Solar maintenance, repair and system upgrades',
	serviceType: 'Solar system maintenance',
	areaServed: 'Waikato, New Zealand',
};
---

<BaseLayout
	title="Solar Maintenance Waikato"
	description="Solar checks, repair and upgrades across Waikato, including systems installed by other providers. Keep output up, catch faults early and stay warranty-ready."
	image="/images/maintenance-hero.jpg"
	schema={maintenanceSchema}
>
	<Hero
		page
		title="Maintenance"
		intro="We do not install and walk away.<br />Repair, upgrade or a check, even if someone else put it up."
		image="/images/maintenance-hero.jpg"
		alt="An Energy Point specialist supporting a solar energy system"
		cta="Book a service"
		ctaHref="/contact/?audience=Maintenance"
		position="center bottom"
	/>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<h2>Look after what is already up</h2>
					<p>
						Solar is a long-term investment. We keep it clean, safe and earning: whether we
						installed it or not.
					</p>
				</div>
			</div>
			<div class="reason-grid">
				{
					whyItMatters.map((reason, index) => (
						<article
							class="reason-card"
							data-reveal
							style={`--reveal-delay: ${index * 40}ms`}
						>
							<span class="reason-card__number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{reason.title}</h3>
								<p>{reason.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<BenefitsGrid items={carePaths} />
		</div>
	</section>

	<CTASection
		audience="Maintenance"
		title="Keep the system in top shape"
		copy="Book a maintenance check or talk to us about a regular service plan. Tell us what you are seeing, when it started and who installed it."
		label="Book a service"
	/>
</BaseLayout>
