---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { faqAudiences, faqCopy, faqGroups } from '../data/faqs';
import BaseLayout from '../layouts/BaseLayout.astro';

const audienceLabels = {
	residential: 'Residential',
	commercial: 'Commercial',
	rural: 'Rural',
} as const;

const allFaqs = faqGroups.flatMap((group) => group.items.map((item) => faqCopy(item)));
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: allFaqs.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<BaseLayout
	title="Solar FAQs"
	description="Clear answers about solar design, installation, savings, finance, maintenance, batteries and monitoring in New Zealand."
	schema={faqSchema}
>
	<Hero
		page
		title="Straight answers"
		intro="What solar can do.<br />What to ask before you decide."
		image="/images/home-detail.png"
		alt="Detailed view of a modern solar energy installation"
		cta="Book a free visit"
		ctaHref="/contact/"
		position="68% 42%"
		positionMobile="82% 38%"
	/>

	<section class="section section--cream section--compact">
		<div class="narrow">
			<div class="faq-toolbar">
				<div class="faq-filters" role="group" aria-label="Filter by property type">
					<button type="button" class="faq-filter" data-faq-audience="" aria-pressed="true">
						All
					</button>
					{
						faqAudiences.map((audience) => (
							<button
								type="button"
								class="faq-filter"
								data-faq-audience={audience}
								aria-pressed="false"
							>
								{audienceLabels[audience]}
							</button>
						))
					}
				</div>

				<label class="sr-only" for="faq-search">Search solar questions</label>
				<div class="faq-search">
					<Icon name="search" />
					<input
						id="faq-search"
						type="search"
						placeholder="Search questions. Try “battery”, “finance” or “maintenance”"
						autocomplete="off"
						data-faq-search
					/>
				</div>
			</div>

			<div data-faq-groups>
				{
					faqGroups.map((group) => (
						<section class="faq-group" data-faq-group>
							<h2>{group.label}</h2>
							<div class="faq-list">
								{group.items.map((item) => {
									const combined = faqCopy(item);
									return (
										<details
											class="faq-item"
											data-faq-item
											data-variants={JSON.stringify(item.variants)}
										>
											<summary>{combined.question}</summary>
											<div class="faq-item__answer">
												<div class="faq-item__answer-inner">
													<p>{combined.answer}</p>
												</div>
											</div>
										</details>
									);
								})}
							</div>
						</section>
					))
				}
			</div>

			<p class="faq-empty" data-faq-empty>
				No answer matched that filter. <a class="text-link" href="/contact/">Ask Energy Point</a>
			</p>
		</div>
	</section>

	<CTASection
		title="Still unsure?"
		copy="Tell us the property and the question. We will give you a practical next step."
		label="Book a free visit"
	/>

	<script>
		document.addEventListener('astro:page-load', () => {
			const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
			const filters = document.querySelectorAll<HTMLButtonElement>('[data-faq-audience]');
			const groups = document.querySelectorAll<HTMLElement>('[data-faq-group]');
			const empty = document.querySelector<HTMLElement>('[data-faq-empty]');
			const allowed = new Set(['residential', 'commercial', 'rural']);
			type VariantKey = 'all' | 'residential' | 'commercial' | 'rural';
			type VariantCopy = { question: string; answer: string };
			type VariantMap = Record<VariantKey, VariantCopy>;

			if (!input || filters.length === 0) return;

			let audience = '';

			const params = new URLSearchParams(window.location.search).get('audience');
			if (params && allowed.has(params)) audience = params;

			const variantKey = (): VariantKey =>
				audience === 'residential' || audience === 'commercial' || audience === 'rural'
					? audience
					: 'all';

			const readVariants = (item: HTMLElement): VariantMap | null => {
				try {
					return JSON.parse(item.dataset.variants ?? '') as VariantMap;
				} catch {
					return null;
				}
			};

			const paintItem = (item: HTMLElement, copy: VariantCopy) => {
				const summary = item.querySelector('summary');
				const answer = item.querySelector('.faq-item__answer-inner p');
				if (summary) summary.textContent = copy.question;
				if (answer) answer.textContent = copy.answer;
			};

			const apply = () => {
				const query = input.value.trim().toLowerCase();
				const key = variantKey();
				let visibleCount = 0;

				groups.forEach((group) => {
					let groupCount = 0;
					group.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((item) => {
						const variants = readVariants(item);
						const copy = variants?.[key];
						if (!copy) {
							item.hidden = true;
							return;
						}
						paintItem(item, copy);
						const haystack = `${copy.question} ${copy.answer}`.toLowerCase();
						const matches = !query || haystack.includes(query);
						item.hidden = !matches;
						if (matches) groupCount += 1;
					});
					group.hidden = groupCount === 0;
					visibleCount += groupCount;
				});

				if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
			};

			const setAudience = (next: string, updateUrl = true) => {
				audience = next;
				filters.forEach((button) => {
					button.setAttribute('aria-pressed', String(button.dataset.faqAudience === audience));
				});
				if (updateUrl) {
					const url = new URL(window.location.href);
					if (audience) url.searchParams.set('audience', audience);
					else url.searchParams.delete('audience');
					history.replaceState({}, '', url);
				}
				apply();
			};

			filters.forEach((button) => {
				button.addEventListener('click', () => {
					setAudience(button.dataset.faqAudience ?? '');
				});
			});

			input.addEventListener('input', apply);
			setAudience(audience, false);
		});
	</script>
</BaseLayout>

