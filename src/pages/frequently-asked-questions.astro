---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { faqGroups } from '../data/faqs';
import BaseLayout from '../layouts/BaseLayout.astro';

const allFaqs = faqGroups.flatMap((group) => group.items);
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: allFaqs.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<BaseLayout
	title="Solar FAQs"
	description="Clear answers about solar design, installation, savings, finance, maintenance, batteries and monitoring in New Zealand."
	image="/images/home-detail.png"
	schema={faqSchema}
>
	<Hero
		page
		title="Your questions, answered simply."
		intro="Straight answers about what solar can do, what it cannot promise, and what a good decision should take into account."
		image="/images/home-detail.png"
		alt="Detailed view of a modern solar energy installation"
		cta="Ask us something specific"
		ctaHref="/contact/"
		position="center"
	/>

	<section class="section section--cream">
		<div class="narrow">
			<div class="section-heading" style="grid-template-columns: 1fr;">
				<div>
					<span class="eyebrow">Find an answer</span>
					<h2>Start with what you need to know.</h2>
					<p class="lede muted">
						Search every answer or browse by design, installation, finance and care.
					</p>
				</div>
			</div>

			<label class="sr-only" for="faq-search">Search solar questions</label>
			<div class="faq-search">
				<Icon name="search" />
				<input
					id="faq-search"
					type="search"
					placeholder="Search questions. Try “battery”, “finance” or “maintenance”"
					autocomplete="off"
					data-faq-search
				/>
			</div>

			<div data-faq-groups>
				{
					faqGroups.map((group) => (
						<section class="faq-group" data-faq-group>
							<h2>{group.label}</h2>
							<div class="faq-list">
								{group.items.map((item) => (
									<details
										class="faq-item"
										data-faq-item
										data-search-text={`${item.question} ${item.answer}`.toLowerCase()}
									>
										<summary>{item.question}</summary>
										<div class="faq-item__answer">
											<div class="faq-item__answer-inner">
												<p>{item.answer}</p>
											</div>
										</div>
									</details>
								))}
							</div>
						</section>
					))
				}
			</div>

			<p class="faq-empty" data-faq-empty>
				No answer matched that search. <a class="text-link" href="/contact/">Ask Energy Point</a>
			</p>
		</div>
	</section>

	<CTASection
		title="Bring us the question behind the question."
		copy="Tell us what you are trying to achieve and where the uncertainty sits. We will give you a practical next step."
		label="Ask Energy Point"
	/>

	<script>
		document.addEventListener('astro:page-load', () => {
			const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
			const groups = document.querySelectorAll<HTMLElement>('[data-faq-group]');
			const empty = document.querySelector<HTMLElement>('[data-faq-empty]');

			if (!input) return;

			input.addEventListener('input', () => {
				const query = input.value.trim().toLowerCase();
				let visibleCount = 0;

				groups.forEach((group) => {
					let groupCount = 0;
					group.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((item) => {
						const matches = !query || item.dataset.searchText?.includes(query);
						item.hidden = !matches;
						if (matches) groupCount += 1;
					});
					group.hidden = groupCount === 0;
					visibleCount += groupCount;
				});

				if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
			});
		});
	</script>
</BaseLayout>

