---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import ProcessIndex from '../components/ProcessIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const commercialReasons = [
	{
		title: 'Lower operating costs',
		copy: 'Daytime power you no longer buy.',
	},
	{
		title: 'Hedge power prices',
		copy: 'Less of the bill at next year’s rate.',
	},
	{
		title: 'Match business hours',
		copy: 'Generation when the site is busy.',
	},
	{
		title: 'Long-term savings',
		copy: 'Decades of power generation.',
	},
	{
		title: 'Smaller carbon footprint',
		copy: 'Cleaner power for the operation.',
	},
	{
		title: 'Low maintenance',
		copy: 'Quiet. Durable. Occasional care.',
	},
	{
		title: 'Ready for fleet charging',
		copy: 'Charge vans on site for less.',
	},
	{
		title: 'Ready for a battery',
		copy: 'Peaks, nights or later when you are.',
	},
] as const;

const commercialSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Commercial solar and business energy design',
	serviceType: 'Commercial solar installation',
	areaServed: 'Waikato, New Zealand',
};
---

<BaseLayout
	title="Commercial Solar Waikato"
	description="Commercial solar for Waikato businesses. Free visit, a plan that fits how the site uses power and support after switch-on."
	image="/images/commercial-hero.jpg"
	schema={commercialSchema}
>
	<Hero
		page
		title="Commercial"
		intro="We look at the hours and load.<br />Then leave a plan."
		image="/images/commercial-hero.jpg"
		alt="Solar panels supplying a commercial energy system"
		cta="Book a free visit"
		ctaHref="/contact/?audience=Commercial"
		position="center 35%"
	/>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<h2>Built for the site</h2>
					<p>
						We look at the hours and load. Generation when the business is busy.
					</p>
				</div>
			</div>
			<div class="reason-grid">
				{
					commercialReasons.map((reason, index) => (
						<article
							class="reason-card"
							data-reveal
							style={`--reveal-delay: ${index * 40}ms`}
						>
							<span class="reason-card__number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{reason.title}</h3>
								<p>{reason.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<span class="eyebrow">How it works</span>
					<h2>From first chat to the grid</h2>
					<p>
						<a class="text-link" href="/how-it-works/">See the full process</a>
					</p>
				</div>
			</div>
			<ProcessIndex />
		</div>
	</section>

	<CTASection
		audience="Commercial"
		title="Book a free visit for the business"
		copy="Start with a no-pressure conversation about the site, the bills and what you want next."
		label="Book a free visit"
	/>
</BaseLayout>
