---
import BenefitsGrid from '../components/BenefitsGrid.astro';
import CTASection from '../components/CTASection.astro';
import EnergyFlow from '../components/EnergyFlow.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Hero from '../components/Hero.astro';
import QuoteGrid from '../components/QuoteGrid.astro';
import { featuredFaqs } from '../data/faqs';
import { testimonials } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const benefits = [
	{
		title: 'Use your own energy',
		copy: 'Match generation to daytime household demand and buy less from the grid.',
		image: '/images/residential-hero.jpg',
		alt: 'Residential solar installation on a Waikato home',
		position: 'center 45%',
	},
	{
		title: 'See what is happening',
		copy: 'Monitor generation and performance from a clear app or online portal.',
		image: '/images/process-design.jpg',
		alt: 'Monitoring and designing a home energy system',
		position: 'center 40%',
	},
	{
		title: 'Prepare for what is next',
		copy: 'Make considered choices about battery storage and EV charging.',
		image: '/images/home-detail.png',
		alt: 'Solar array ready for future home energy needs',
		position: 'center 40%',
	},
	{
		title: 'Keep local support',
		copy: 'Call a Waikato team for maintenance, questions and future upgrades.',
		image: '/images/process-consultation.jpg',
		alt: 'Energy Point specialist meeting a homeowner',
		position: 'center 30%',
	},
];

const homeSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Residential solar and home energy design',
	serviceType: 'Residential solar installation',
	areaServed: 'Waikato, New Zealand',
};
---

<BaseLayout
	title="Residential Solar Waikato"
	description="Residential solar designed around your home, power use and future plans. Local consultation, installation and ongoing support across Waikato."
	image="/images/residential-hero.jpg"
	schema={homeSchema}
>
	<Hero
		page
		title="A smarter home starts with how you use it."
		intro="Lower bills are one outcome. A clear, resilient home energy plan, designed for your routines, roof and future, is the real goal."
		image="/images/residential-hero.jpg"
		alt="Solar panels installed on a contemporary Waikato home"
		cta="Plan my home energy"
		ctaHref="/contact/?audience=Residential"
		position="center 54%"
	/>

	<section class="section section--cream">
		<div class="container intro-statement">
			<div>
				<span class="eyebrow">Home, understood</span>
			</div>
			<div class="intro-statement__body" data-reveal>
				<p>
					Your home has an energy rhythm. The right system is designed to move with it.
				</p>
				<p class="lede muted">
					We look at when you use electricity, where demand is changing and what matters
					most: savings, resilience, an EV, a battery, or simply more control. Then we
					build a system that makes sense now and remains useful later.
				</p>
			</div>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">A better position</span>
					<h2>Turn your roof into part of the household plan.</h2>
				</div>
				<p class="lede muted">
					Solar is most valuable when design, consumption and future demand are considered
					together.
				</p>
			</div>
			<BenefitsGrid items={benefits} />
		</div>
	</section>

	<section class="section section--dark">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">How energy moves</span>
					<h2>Sunlight in. Useful power out.</h2>
				</div>
				<p class="lede muted">
					The technology is sophisticated. Your understanding of it should be simple.
				</p>
			</div>
			<EnergyFlow />
		</div>
	</section>

	<section class="media-split">
		<div class="media-split__media">
			<img
				src="/images/process-design-1600.webp"
				alt="Energy Point planning a home solar system"
				width="1400"
				height="900"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="media-split__content">
			<span class="eyebrow">Designed, not bundled</span>
			<h2>Every decision should have a reason.</h2>
			<p class="lede">
				Panel position, inverter capacity, switchboard work and battery readiness all affect
				what the system can do. We explain the trade-offs and show you why the proposed
				design fits.
			</p>
			<ul class="feature-list">
				<li>Usage-led system sizing</li>
				<li>Roof and shading assessment</li>
				<li>Clear component choices</li>
				<li>Future upgrade pathway</li>
			</ul>
			<a class="button button--ghost" href="/contact/?audience=Residential">
				Book a home consultation
			</a>
		</div>
	</section>

	<section class="section section--cream">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">From first visit to switch-on</span>
					<h2>A calm, considered installation journey.</h2>
				</div>
				<p class="lede muted">
					We coordinate the technical detail while keeping you clear on what happens next.
				</p>
			</div>
			<div class="numbered-grid">
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">01</span>
					<div>
						<h3>Site and usage review</h3>
						<p>We visit, listen and understand your energy profile and property.</p>
					</div>
				</article>
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">02</span>
					<div>
						<h3>Technical proposal</h3>
						<p>You receive a clear design, scope, assumptions and expected programme.</p>
					</div>
				</article>
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">03</span>
					<div>
						<h3>Professional installation</h3>
						<p>Certified professionals install and commission with respect for your home.</p>
					</div>
				</article>
				<article class="numbered-item" data-reveal>
					<span class="numbered-item__number">04</span>
					<div>
						<h3>Handover and support</h3>
						<p>We connect monitoring, explain your system and stay available afterwards.</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section section--forest">
		<div class="container">
			<div class="section-heading">
				<div>
					<span class="eyebrow">Customer perspective</span>
					<h2>Clear advice. No pressure. A system that fits.</h2>
				</div>
				<p class="lede muted">
					What homeowners say after working through the process with us.
				</p>
			</div>
			<QuoteGrid items={testimonials.residential} />
			<p style="margin-top: 2rem;">
				<a class="text-link" href="/reviews/">Read more reviews</a>
			</p>
		</div>
	</section>

	<section class="section section--paper">
		<div class="container faq-layout">
			<div class="faq-intro">
				<span class="eyebrow">Home solar questions</span>
				<h2>Know what you are deciding.</h2>
				<a class="text-link" href="/frequently-asked-questions/">Read every answer</a>
			</div>
			<FAQAccordion items={featuredFaqs} />
		</div>
	</section>

	<CTASection
		audience="Residential"
		title="Make the roof work for the life below it."
		copy="Start with a no-pressure conversation about your home, energy use and future plans."
		label="Plan my home system"
	/>
</BaseLayout>

