---
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import ProcessIndex from '../components/ProcessIndex.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const homeReasons = [
	{
		title: 'Lower energy bills',
		copy: 'Daytime power you no longer buy.',
	},
	{
		title: 'Boost property value',
		copy: 'The system stays with the house.',
	},
	{
		title: 'Energy independence',
		copy: 'Less tied to the power company.',
	},
	{
		title: 'Long-term savings',
		copy: 'Decades of power generation.',
	},
	{
		title: 'Smaller carbon footprint',
		copy: 'Cleaner power from your own roof.',
	},
	{
		title: 'Low maintenance',
		copy: 'Quiet. Durable. Occasional care.',
	},
	{
		title: 'Ready for an EV',
		copy: 'Charge the car at home for less.',
	},
	{
		title: 'Ready for a battery',
		copy: 'Night, cloudy days or later when you are.',
	},
] as const;

const homeSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Residential solar and home energy design',
	serviceType: 'Residential solar installation',
	areaServed: 'Waikato, New Zealand',
};
---

<BaseLayout
	title="Residential Solar Waikato"
	description="Residential solar for Waikato homes. Free visit, a plan that fits how you use power and a local team after switch-on."
	schema={homeSchema}
>
	<Hero
		page
		title="Residential"
		intro="We visit the house and the bill.<br />Then leave a plan."
		image="/images/finance-hero.jpg"
		alt="Solar panels installed on a contemporary Waikato home"
		cta="Book a free visit"
		ctaHref="/contact/?audience=Residential"
		position="center 45%"
	/>

	<section class="section section--paper section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<h2>Built for the house</h2>
					<p>
						We visit the house and the bill, then leave a plan that fits how you use power.
					</p>
				</div>
			</div>
			<div class="reason-grid">
				{
					homeReasons.map((reason, index) => (
						<article
							class="reason-card"
							data-reveal
							style={`--reveal-delay: ${index * 40}ms`}
						>
							<span class="reason-card__number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h3>{reason.title}</h3>
								<p>{reason.copy}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--cream section--compact">
		<div class="container">
			<div class="section-heading section-heading--solo">
				<div>
					<span class="eyebrow">How it works</span>
					<h2>From first chat to the grid</h2>
				</div>
			</div>
			<ProcessIndex />
		</div>
	</section>

	<CTASection
		audience="Residential"
		title="Book a free visit for your home"
		copy="Start with a no-pressure conversation about your roof, your bill and what you want next."
		label="Book a free visit"
	/>
</BaseLayout>
